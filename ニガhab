-- ----- Auto Loader -----
-- ONにすると、サーバー移動(Rejoin / Server Hop / ゲーム内テレポート)後に自動で再ロードします。
-- 読み込み元は「スクリプトのファイルパス(workspace内)」または「rawのURL」を指定します。
do -- [fix] local変数上限(200)回避のためスコープ分割
local AL_FILE, AL_LOADER_FILE = "kooa/autoload.json", "kooa/kooa_autoload.lua"
local AL = { enabled = false, delay = 7, source = "kooa/kooa_main.lua" }

local function alEnsureFolder()
    pcall(function()
        if makefolder then
            if not isfolder("kooa") then makefolder("kooa") end
        end
    end)
end
pcall(function()
    if isfile and isfile(AL_FILE) then
        local d = HttpService:JSONDecode(readfile(AL_FILE))
        if type(d) == "table" then
            AL.enabled = d.enabled == true
            AL.delay = tonumber(d.delay) or AL.delay
            AL.source = type(d.source) == "string" and d.source ~= "" and d.source or AL.source
        end
    end
end)
local function alSave()
    alEnsureFolder()
    pcall(function() writefile(AL_FILE, HttpService:JSONEncode(AL)) end)
end
local function alLoaderCode()
    return string.format([[
local function note(t)
    pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "kooa AutoLoad", Text = t, Duration = 8 }) end)
    warn("[kooa autoload] " .. t)
end
if not game:IsLoaded() then game.Loaded:Wait() end
task.wait(%d)
local src = %q
local ok, code = pcall(function()
    if src:match("^https?://") then return game:HttpGet(src) end
    return readfile(src)
end)
if not ok or type(code) ~= "string" or code == "" then
    note("読み込み失敗: " .. src .. " (パス/URLを確認)")
    return
end
local fn, err = loadstring(code)
if not fn then note("コンパイル失敗: " .. tostring(err):sub(1, 120)) return end
local ok2, err2 = pcall(fn)
if not ok2 then note("実行エラー: " .. tostring(err2):sub(1, 120)) end
]], math.floor(AL.delay), AL.source)
end
local alWarned = false
-- force=true (テレポート直前) のときだけ queue_on_teleport に積む。
-- 設定変更のたびに積むと、移動後にローダーが何回も走るため。
local function alQueue(force)
    if not AL.enabled or AL.source == "" then return end
    if force then
        local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
        if q then
            local ok, err = pcall(q, alLoaderCode())
            if not ok then pcall(function() Library:Notify("queue_on_teleport 失敗: " .. tostring(err), 6) end) end
        elseif not alWarned then
            alWarned = true
            pcall(function() Library:Notify("このexecutorは queue_on_teleport 非対応です。autoexecを使ってください", 8) end)
        end
    end
    alEnsureFolder()
    pcall(function() writefile(AL_LOADER_FILE, alLoaderCode()) end)
end
LP.OnTeleport:Connect(function() alQueue(true) end)

MiscAuto:AddToggle("AutoLoadToggle", { Text = "Auto Load", Default = AL.enabled, Callback = function(v)
    AL.enabled = v; alSave(); alQueue()
    if v then
        local ok = isfile and pcall(isfile, AL.source) and not AL.source:match("^https?://") and isfile(AL.source)
        if not AL.source:match("^https?://") and not ok then
            pcall(function() Library:Notify("Auto Load: " .. AL.source .. " が見つかりません (パスかURLを確認)", 6) end)
        end
    end
end })
MiscAuto:AddSlider("AutoLoadDelay", { Text = "Delay (sec)", Min = 0, Max = 30, Default = AL.delay, Rounding = 0, Callback = function(v)
    AL.delay = v; alSave(); alQueue()
end })
MiscAuto:AddInput("AutoLoadSource", { Text = "Script path / URL", Default = AL.source, Placeholder = "kooa/kooa_main.lua または https://...", Finished = true,
