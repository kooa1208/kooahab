local weatherPart = Instance.new("Part"); weatherPart.Size = Vector3.new(WX.Area,1,WX.Area); weatherPart.Transparency = 1; weatherPart.Anchored = true; weatherPart.CanCollide = false; weatherPart.Parent = workspace
local weatherEmitters = {}
local weatherEnabled = false
local currentWeather = "Snow"

local function scaleSeq(seq, m)
    local k = {}
    for i, kp in ipairs(seq.Keypoints) do k[i] = NumberSequenceKeypoint.new(kp.Time, kp.Value * m, kp.Envelope * m) end
    return NumberSequence.new(k)
end

local function setWeather(preset)
    for _,e in ipairs(weatherEmitters) do e:Destroy() end
    weatherEmitters = {}
    currentWeather = preset
    if not weatherEnabled or not preset then return end

    local specs = {
        Snow = {{Texture="rbxasset://textures/particles/smoke_main.dds", Rate=220, Speed=NumberRange.new(6,10), Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.35),NumberSequenceKeypoint.new(1,0.25)}), Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.15,0.15),NumberSequenceKeypoint.new(0.85,0.15),NumberSequenceKeypoint.new(1,1)}), Color=ColorSequence.new(Color3.new(1,1,1))}},
        -- 雨: 少なめ(Rate)・細長い(Squash)・ゆっくり(Speed)。線が横向きなら Squash の符号を反転
        Rain = {{Texture="rbxasset://textures/particles/smoke_main.dds", Rate=90, Lifetime=NumberRange.new(2.4,3), Speed=NumberRange.new(22,28), SpreadAngle=Vector2.new(1,1), Acceleration=Vector3.new(0,-4,0), Squash=NumberSequence.new(0.9), Size=NumberSequence.new({NumberSequenceKeypoint.new(0,1.8),NumberSequenceKeypoint.new(1,1.8)}), Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.1,0.45),NumberSequenceKeypoint.new(0.9,0.45),NumberSequenceKeypoint.new(1,1)}), Color=ColorSequence.new(Color3.fromRGB(190,210,255)), Orientation=Enum.ParticleOrientation.VelocityParallel}},
        Blizzard = {{Texture="rbxasset://textures/particles/smoke_main.dds", Rate=700, Lifetime=NumberRange.new(3,5), SpreadAngle=Vector2.new(35,35), Acceleration=Vector3.new(0,-6,0), Speed=NumberRange.new(18,28), Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.3),NumberSequenceKeypoint.new(1,0.2)}), Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.15,0.1),NumberSequenceKeypoint.new(0.85,0.1),NumberSequenceKeypoint.new(1,1)}), Color=ColorSequence.new(Color3.new(1,1,1))}},
    }
    local rad = math.rad(WX.WindAngle)
    local wind = Vector3.new(math.cos(rad), 0, math.sin(rad)) * WX.WindStrength
    for _,spec in ipairs(specs[preset] or {}) do
        local pe = Instance.new("ParticleEmitter")
        pe.Texture = spec.Texture
        pe.Rate = spec.Rate * WX.Rate * WX.Intensity
        pe.Speed = NumberRange.new(spec.Speed.Min * WX.Speed, spec.Speed.Max * WX.Speed)
        pe.Size = scaleSeq(spec.Size, WX.Size)
        pe.Transparency = spec.Transparency
        pe.Color = WX.UseColor and ColorSequence.new(WX.Color) or spec.Color
        pe.LightEmission = WX.Glow
        pe.Shape = Enum.ParticleEmitterShape.Box; pe.EmissionDirection = Enum.NormalId.Bottom; pe.LockedToPart = true
        if spec.Orientation then pe.Orientation = spec.Orientation end
        pe.Acceleration = (spec.Acceleration or Vector3.zero) + wind
        if spec.Lifetime then pe.Lifetime = spec.Lifetime end
        if spec.SpreadAngle then pe.SpreadAngle = spec.SpreadAngle end
        if spec.Squash then pe.Squash = spec.Squash end
        pe.Parent = weatherPart
        table.insert(weatherEmitters, pe)
    end
end
local function refreshWeather() if weatherEnabled then setWeather(currentWeather) end end

-- 雷 (ギザギザの稲妻をレイキャストで地面まで落とす)
local lightningConn = nil
local function strike()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local base = cam.CFrame.Position + Vector3.new(math.random(-WX.LDistance, WX.LDistance), 0, math.random(-WX.LDistance, WX.LDistance))
    local hit = workspace:Raycast(base + Vector3.new(0, 300, 0), Vector3.new(0, -600, 0))
    local ground = hit and hit.Position or (base - Vector3.new(0, 20, 0))
    local top = Vector3.new(ground.X, ground.Y + WX.LHeight, ground.Z)
    local pts, n = { top }, 8
    for i = 1, n - 1 do
        local p = top:Lerp(ground, i / n)
        pts[#pts + 1] = p + Vector3.new(math.random(-6, 6), 0, math.random(-6, 6))
    end
    pts[#pts + 1] = ground
    local folder = Instance.new("Folder"); folder.Name = "KooaLightning"; folder.Parent = workspace
    for i = 1, #pts - 1 do
        local a, b = pts[i], pts[i + 1]
        local len = (a - b).Magnitude
        if len > 0.01 then
            local p = Instance.new("Part")
            p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
            p.Material = Enum.Material.Neon; p.Color = WX.LColor
            p.Size = Vector3.new(WX.LThickness, WX.LThickness, len)
            p.CFrame = CFrame.lookAt((a + b) / 2, b)
            p.Parent = folder
        end
    end
    task.delay(0.2, function() folder:Destroy() end)
end
local function setLightning(on)
    if lightningConn then task.cancel(lightningConn) lightningConn = nil end
    if on then
        lightningConn = task.spawn(function()
            while true do
                task.wait(WX.LInterval * (0.7 + math.random() * 0.6))
                pcall(strike)
            end
        end)
    end
end

