-- Drawing ライブラリ不要版 (BillboardGui / LineHandleAdornment で描画するので、Drawingが無い実行環境でも動く)
do
    local espParent
    do
        local ok, h = pcall(function() return typeof(gethui) == "function" and gethui() or nil end)
        espParent = ok and h or nil
        if not espParent then
            local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
            espParent = ok2 and cg or nil
        end
    end
    local espFolder = Instance.new("Folder")
    espFolder.Name = "KooaESP"
    local okP = pcall(function() espFolder.Parent = espParent end)
    if not okP or not espFolder.Parent then espFolder.Parent = LP:WaitForChild("PlayerGui") end

    local WHITE = Color3.new(1, 1, 1)
    local cache = {}

    local function getRank(player)
        local elo = player:GetAttribute("DisplayELO")
        if type(elo) == "number" then
            if elo >= 3500 then return "Mythic"
            elseif elo >= 2800 then return "Legendary"
            elseif elo >= 2200 then return "Epic"
            elseif elo >= 1600 then return "Rare"
            elseif elo >= 1000 then return "Uncommon"
            else return "Common" end
        end
        return "Unranked"
    end

    local function mkLabel(parent, size, color, ypos)
        local l = Instance.new("TextLabel")
        l.BackgroundTransparency = 1
        l.Size = UDim2.new(1, 0, 0.5, 0)
        l.Position = UDim2.new(0, 0, ypos, 0)
        l.Font = Enum.Font.GothamBold
        l.TextSize = size
        l.TextColor3 = color
        l.TextStrokeTransparency = 0
        l.TextStrokeColor3 = Color3.new(0, 0, 0)
        l.Text = ""
        l.Parent = parent
        return l
    end

    local function mkBillboard(adornee, size, offset)
        local bb = Instance.new("BillboardGui")
        bb.Adornee = adornee
        bb.AlwaysOnTop = true
        bb.LightInfluence = 0
        bb.ResetOnSpawn = false
        bb.Size = size
        bb.StudsOffset = offset or Vector3.zero
        bb.Enabled = false
        bb.Parent = espFolder
        return bb
    end

    local function mkLine()
        local a = Instance.new("LineHandleAdornment")
        a.Thickness = 2
        a.AlwaysOnTop = true
        a.ZIndex = 1
        a.Color3 = WHITE
        a.Visible = false
        a.Parent = espFolder
        return a
    end

    local function destroyEntry(e)
        for _, o in ipairs(e.objs) do pcall(function() o:Destroy() end) end
    end

    local function build(player, char)
        local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if not hrp then return nil end
        local e = { char = char, hrp = hrp, objs = {}, skel = {} }

        -- Box + HealthBar (スタッド単位で大きさが決まるので距離で自動的に縮む)
        e.boxGui = mkBillboard(hrp, UDim2.new(4.5, 0, 6, 0))
        local box = Instance.new("Frame")
        box.BackgroundTransparency = 1; box.BorderSizePixel = 0; box.Size = UDim2.fromScale(1, 1); box.Parent = e.boxGui
        local stroke = Instance.new("UIStroke"); stroke.Thickness = 1.5; stroke.Color = WHITE; stroke.Parent = box
        e.box = box; e.stroke = stroke
        local hpBg = Instance.new("Frame")
        hpBg.BackgroundColor3 = Color3.new(0, 0, 0); hpBg.BorderSizePixel = 0
        hpBg.Position = UDim2.new(0, -7, 0, 0); hpBg.Size = UDim2.new(0, 4, 1, 0); hpBg.Parent = e.boxGui
        local hpBar = Instance.new("Frame")
        hpBar.BorderSizePixel = 0; hpBar.AnchorPoint = Vector2.new(0, 1)
        hpBar.Position = UDim2.new(0, 0, 1, 0); hpBar.Size = UDim2.new(1, 0, 1, 0); hpBar.Parent = hpBg
        e.hpBg, e.hpBar = hpBg, hpBar

        -- Name
        e.nameGui = mkBillboard(hrp, UDim2.fromOffset(200, 20), Vector3.new(0, 3.9, 0))
        e.nameLabel = mkLabel(e.nameGui, 14, WHITE, 0); e.nameLabel.Size = UDim2.new(1, 0, 1, 0)

        -- Rank + Weapon
        e.infoGui = mkBillboard(hrp, UDim2.fromOffset(200, 36), Vector3.new(0, -4.2, 0))
        e.rankLabel = mkLabel(e.infoGui, 12, Color3.fromRGB(255, 255, 0), 0)
        e.weaponLabel = mkLabel(e.infoGui, 12, WHITE, 0.5)

        e.tracer = mkLine()
        table.insert(e.objs, e.boxGui); table.insert(e.objs, e.nameGui); table.insert(e.objs, e.infoGui); table.insert(e.objs, e.tracer)
        return e
    end

    local function hide(e)
        e.boxGui.Enabled = false; e.nameGui.Enabled = false; e.infoGui.Enabled = false
        e.tracer.Visible = false
        for _, l in ipairs(e.skel) do l.Visible = false end
    end

    local function setLine(a, partA, posB)
        local d = posB - partA.Position
        if d.Magnitude < 0.01 then a.Visible = false return end
        a.Adornee = partA
        a.Color3 = espColor
        a.Length = d.Magnitude
        a.CFrame = partA.CFrame:ToObjectSpace(CFrame.lookAt(partA.Position, posB))
        a.Visible = true
    end

    local r15 = {"Head","UpperTorso","LowerTorso","LeftUpperArm","LeftLowerArm","LeftHand","RightUpperArm","RightLowerArm","RightHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot"}
    local r15c = {
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    }
    local r6c = {{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}

    local function updateSkeleton(e)
        local conns = e.char:FindFirstChild("UpperTorso") and r15c or r6c
        for i, c in ipairs(conns) do
            if not e.skel[i] then e.skel[i] = mkLine(); table.insert(e.objs, e.skel[i]) end
            local p1, p2 = e.char:FindFirstChild(c[1]), e.char:FindFirstChild(c[2])
            if p1 and p2 and p1:IsA("BasePart") and p2:IsA("BasePart") then
                setLine(e.skel[i], p1, p2.Position)
            else
                e.skel[i].Visible = false
            end
        end
        for i = #conns + 1, #e.skel do e.skel[i].Visible = false end
    end

    RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if not cam then return end

        -- 退出したプレイヤーの掃除
        for player, e in pairs(cache) do
            if not player.Parent then destroyEntry(e) cache[player] = nil end
        end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP then
                local char = player.Character
                local e = cache[player]
                if e and (e.char ~= char or not e.hrp.Parent) then
                    destroyEntry(e); cache[player] = nil; e = nil
                end

                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local alive = char ~= nil and (hum == nil or hum.Health > 0)

                if not espEnabled or not alive then
                    if e then hide(e) end
                else
                    if not e then e = build(player, char) cache[player] = e end
                    if e then
                        e.boxGui.Enabled = espBox or espHP
                        e.box.Visible = espBox
                        e.stroke.Color = espColor
                        e.hpBg.Visible = espHP
                        if espHP then
                            local perc = hum and math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1) or 1
                            e.hpBar.Size = UDim2.new(1, 0, perc, 0)
                            e.hpBar.BackgroundColor3 = Color3.fromHSV(perc * 0.3, 1, 1)
                        end

                        e.nameGui.Enabled = espName
                        if espName then
                            local nm = player.Name
                            if espDistance then nm = nm .. " [" .. math.floor((e.hrp.Position - cam.CFrame.Position).Magnitude) .. "m]" end
                            e.nameLabel.Text = nm
                        end

                        local tool = espWeapon and char:FindFirstChildOfClass("Tool")
                        e.infoGui.Enabled = espRank or (tool ~= nil and tool ~= false)
                        e.rankLabel.Text = espRank and getRank(player) or ""
                        e.weaponLabel.Text = tool and tool.Name or ""

                        if espTracer then
                            local ray = cam:ViewportPointToRay(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                            setLine(e.tracer, e.hrp, ray.Origin + ray.Direction * 3)
                        else
                            e.tracer.Visible = false
                        end

                        if espSkeleton then
                            updateSkeleton(e)
                        else
                            for _, l in ipairs(e.skel) do l.Visible = false end
                        end
                    end
                end
            end
        end
    end)
end

