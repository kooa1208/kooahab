            local cc = Instance.new("UICorner"); cc.CornerRadius = UDim.new(1, 0); cc.Parent = c
            glowLayers[i] = c
        end
        M.glow = 0.5
        local function applyGlow()
            for _, c in ipairs(glowLayers) do c.BackgroundTransparency = 1 - 0.05 * M.glow end
        end
        applyGlow()
        local img = Instance.new("ImageLabel")
        img.BackgroundTransparency = 1; img.AnchorPoint = Vector2.new(0.5, 0.5); img.ZIndex = 2; img.Visible = false
        img.Image = moonTex; img.ScaleType = Enum.ScaleType.Crop; img.ImageTransparency = 0.12; img.ImageColor3 = Color3.fromRGB(228, 228, 242); img.Parent = gui
        local ic = Instance.new("UICorner"); ic.CornerRadius = UDim.new(1, 0); ic.Parent = img

        local function placeHere()
            local cam = workspace.CurrentCamera
            if not cam then return end
            local look = cam.CFrame.LookVector
            M.dir = math.deg(math.atan2(look.X, -look.Z)) % 360
            pcall(function() Library.Options.SkyMoonDir:SetValue(math.floor(M.dir + 0.5)) end)
        end

        RunService.RenderStepped:Connect(function()
            if not moonOn then
                if gui.Enabled then gui.Enabled = false end
                return
            end
            if not gui.Enabled then gui.Enabled = true end
            if gui.Parent ~= PlayerGui then pcall(function() gui.Parent = PlayerGui end) end
            local cam = workspace.CurrentCamera
            if not cam then return end
            if img.Image ~= moonTex then img.Image = moonTex; M.t0 = os.clock(); M.warned = false end
            -- アセットが画像として読み込めない場合の保険 (Roblox標準の月に切り替えて、何も出ない状態を避ける)
            if not img.IsLoaded and not M.warned and os.clock() - M.t0 > 8 then
                M.warned = true
                img.Image = "rbxasset://sky/moon.jpg"
                pcall(function() Library:Notify("Moon: アセット " .. tostring(moonTex) .. " を画像として読み込めませんでした (標準の月で代用)", 6) end)
            end
            local az, el = math.rad(M.dir), math.rad(M.elev)
            local dir = Vector3.new(math.sin(az) * math.cos(el), math.sin(el), -math.cos(az) * math.cos(el))
            local origin = cam.CFrame.Position
            local v, onScreen = cam:WorldToViewportPoint(origin + dir * 5000)
            local visible = onScreen and v.Z > 0
            if visible then
                local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
                local ignore = { LP.Character }
                for _ = 1, 6 do
                    params.FilterDescendantsInstances = ignore
                    local r = workspace:Raycast(origin, dir * 6000, params)
                    if not r then break end
                    local inst = r.Instance
                    if inst.Transparency >= 0.9 or inst:IsDescendantOf(cam) or inst.CanCollide == false and inst.CanQuery == false then
                        table.insert(ignore, inst)
                    else visible = false break end
                end
            end
            img.Visible, halo.Visible = visible, visible
            if not visible then return end
            local vp = cam.ViewportSize
            local px = 2 * math.tan(math.rad(M.size) / 2) / math.tan(math.rad(cam.FieldOfView) / 2) * (vp.Y / 2)
            local pos = UDim2.fromOffset(v.X, v.Y)
            img.Position = pos; img.Size = UDim2.fromOffset(px, px)
            halo.Position = pos; halo.Size = UDim2.fromOffset(px * 2.4, px * 2.4)
        end)
