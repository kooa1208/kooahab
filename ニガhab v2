do
    -- Rivals側が既にSkyを持っているので、追加ではなく既存Skyのプロパティを書き換える (Kiciaと同じ方式)
    local skyEnabled = false
    local skyNames = {}
    for name in pairs(skyPresets) do table.insert(skyNames, name) end
    table.sort(skyNames)
    local skyCurrent = skyNames[1]
    local skyBackup, skyConns, skyCreated = {}, {}, nil
    local faceProps = {"SkyboxUp","SkyboxDn","SkyboxFt","SkyboxBk","SkyboxLf","SkyboxRt"}

    local moonOn, moonSize, skyOff = false, 11, {}
    local realMoon = { on = false, size = 18, time = 21, gray = 150, elev = 25, exp = 0.5 } -- 本物の空の月モード
    local moonTex = "rbxassetid://9431798152" -- 月のテクスチャ
    local function effPreset(preset)
        if not next(skyOff) and not realMoon.on then return preset end
        local e = {}
        for k, v in pairs(preset) do e[k] = v end
        if realMoon.on then
            -- アセットIDではなく、Roblox標準の月テクスチャで本物の空の月を出す
            e.CelestialBodiesShown = true
            e.MoonTextureId = "rbxasset://sky/moon.jpg"
            e.MoonAngularSize = realMoon.size
        end
        -- disable で選んだものは最後に上書き (太陽 / 月 / 星を消す)
        if skyOff.sun then e.SunAngularSize = 0 end
        if skyOff.moon then e.MoonAngularSize = 0 end
        if skyOff.stars then e.StarCount = 0 end
        if realMoon.on then e.MoonAngularSize = realMoon.size; e.CelestialBodiesShown = true end -- Real Moon中は月を消さない
        return e
    end
    -- スカイボックスOFFでも、disable / Moon の指定があればその分だけ既存Skyに適用する
    local function curPreset()
        if skyEnabled then return skyPresets[skyCurrent] end
        if next(skyOff) or realMoon.on then return {} end
        return nil
    end
    local guardProps = {"SkyboxUp","SkyboxDn","SkyboxFt","SkyboxBk","SkyboxLf","SkyboxRt","MoonAngularSize","MoonTextureId","CelestialBodiesShown","SunAngularSize","StarCount"}
    local function paintSky(sky, preset)
        preset = effPreset(preset)
        if not skyBackup[sky] then
            local b = {}
            for k in pairs(preset) do pcall(function() b[k] = sky[k] end) end
            skyBackup[sky] = b
        end
        for k, v in pairs(preset) do
            pcall(function() if sky[k] ~= v then sky[k] = v end end)
        end
    end
    local function guardSky(sky)
        for _, prop in ipairs(guardProps) do
            table.insert(skyConns, sky:GetPropertyChangedSignal(prop):Connect(function()
                local pr = curPreset()
                if pr then paintSky(sky, pr) end
            end))
        end
    end
    local function clearSky()
        for _, c in ipairs(skyConns) do c:Disconnect() end
        skyConns = {}
        for sky, b in pairs(skyBackup) do
            if sky.Parent then for k, v in pairs(b) do pcall(function() sky[k] = v end) end end
        end
        skyBackup = {}
        if skyCreated then skyCreated:Destroy() skyCreated = nil end
    end
    local function applySky()
        clearSky()
        local preset = curPreset()
        if not preset then return end
        local found = false
        for _, o in ipairs(Lighting:GetChildren()) do
            if o:IsA("Sky") then found = true paintSky(o, preset) guardSky(o) end
        end
        if not found then
            skyCreated = Instance.new("Sky"); skyCreated.Name = "kooaSky"
            paintSky(skyCreated, preset); skyCreated.Parent = Lighting; guardSky(skyCreated)
        end
        table.insert(skyConns, Lighting.ChildAdded:Connect(function(o)
            local pr = curPreset()
            if pr and o:IsA("Sky") and o ~= skyCreated then paintSky(o, pr) guardSky(o) end
        end))
    end

    -- yokai: ストアのアセット(99903673568308)が Sky モデルでも Decal/画像でも使えるよう、
    -- 実体を読み込んで中身(Sky の6面 / 画像ID)に差し替える。失敗時は生IDを6面に貼る。
    for _, def in ipairs({ { "yokai", "rbxassetid://99903673568308" }, { "yokai2", "rbxassetid://8107887936" } }) do
        task.spawn(function()
            task.wait(2)
            local name, key = def[1], def[2]
            for _ = 1, 4 do
                local ok, objs = pcall(function() return game:GetObjects(key) end)
                local root = ok and type(objs) == "table" and objs[1]
                if root then
                    local sky = root:IsA("Sky") and root or root:FindFirstChildWhichIsA("Sky", true)
                    local pr = skyPresets[name]
                    if sky then
                        for _, f in ipairs(faceProps) do pr[f] = sky[f] end
                        pcall(function() pr.StarCount = sky.StarCount end)
                    else
                        local img = root:IsA("Decal") and root or root:FindFirstChildWhichIsA("Decal", true)
                        img = img or (root:IsA("Texture") and root) or root:FindFirstChildWhichIsA("Texture", true)
                        local tex = img and img.Texture
                        if tex and tex ~= "" then for _, f in ipairs(faceProps) do pr[f] = tex end end
                    end
                    if skyEnabled and skyCurrent == name then applySky() end
                    break
                end
                task.wait(2)
            end
        end)
    end

    task.spawn(function()
        task.wait(2)
        for _ = 1, 4 do
            local ok, objs = pcall(function() return game:GetObjects("rbxassetid://9431798152") end)
            local root = ok and type(objs) == "table" and objs[1]
            if root then
                -- アセットの種類を問わず、使える画像(テクスチャ)を探す
                local function pick(o)
                    if o:IsA("Decal") or o:IsA("Texture") then return o.Texture, o.ClassName end
                    if o:IsA("ImageLabel") or o:IsA("ImageButton") then return o.Image, o.ClassName end
                    if o:IsA("ParticleEmitter") then return o.Texture, o.ClassName end
                    if o:IsA("Sky") then return o.MoonTextureId, "Sky.MoonTextureId" end
                    if o:IsA("SpecialMesh") then return o.TextureId, "SpecialMesh.TextureId" end
                    if o:IsA("MeshPart") then return o.TextureID, "MeshPart.TextureID" end
                    if o:IsA("SurfaceAppearance") then return o.ColorMap, "SurfaceAppearance.ColorMap" end
                    return nil
                end
                local list = { root }
                for _, d in ipairs(root:GetDescendants()) do list[#list + 1] = d end
                local tex, how
                for _, o in ipairs(list) do
                    local ok2, t, h = pcall(pick, o)
                    if ok2 and t and t ~= "" then
                        tex, how = t, h
                        break
                    end
                end
                if tex then
                    moonTex = tex
                    for _, n in ipairs({ "yokai", "yokai2" }) do skyPresets[n].MoonTextureId = tex end
                    if moonOn or skyCurrent == "yokai" or skyCurrent == "yokai2" then applySky() end
                    pcall(function() Library:Notify("Moon: " .. how .. " から画像を取得しました", 5) end)
                else
                    local cls = {}
                    for i = 1, math.min(#list, 8) do cls[#cls + 1] = list[i].ClassName end
                    pcall(function() Library:Notify("Moon: 画像が見つかりません。アセットの中身: " .. table.concat(cls, ", "), 8) end)
                end
                break
            end
            task.wait(2)
        end
    end)

    VisualLeft3:AddToggle("SkyboxToggle", { Text = "Enable Skybox", Default = false, Callback = function(v) skyEnabled = v applySky() end })
    VisualLeft3:AddDropdown("SkyboxPreset", { Text = "Skybox Preset", Values = skyNames, Default = 1, Searchable = true, Callback = function(v) skyCurrent = v if skyEnabled then applySky() end end })
    VisualLeft3:AddDropdown("SkyDisable", { Text = "disable", Values = { "sun", "moon", "stars" }, Multi = true, Default = nil, AllowNull = true, Callback = function(v)
        skyOff = {}
        if type(v) == "table" then for k, on in pairs(v) do if on then skyOff[k] = true end end end
        applySky()
    end })
    -- 昼でも / 時間を変えなくても月を出す (空のMoonプロパティ + 画面上のMoon Overlay の両方をON)
    -- 月: ClockTimeを一切使わない。画面に画像アセット(moonTex)を描き、空の一定方向(世界固定)に追従させる。
    -- 壁・地形の後ろに入ると隠れる(レイキャスト)。ONにした瞬間に「今向いている方向」へ置く。
    do
        local PlayerGui = LP:WaitForChild("PlayerGui")
