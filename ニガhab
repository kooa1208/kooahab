                if hum.DisplayName ~= cfg.nameV then hum.DisplayName = cfg.nameV end
            elseif humOrig[hum] ~= nil then
                hum.DisplayName = humOrig[hum]; humOrig[hum] = nil
            end
        end
    end
end

local function applyAll()
    pcall(function()
        rebuildNameMap()
        for obj in pairs(textObjs) do pcall(applyOne, obj) end
        applyHumanoids()
        applyAttrs()
    end)
end
