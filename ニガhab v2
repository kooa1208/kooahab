    local overrides = {}
    local function Ov(inst, prop, default)
        local o = { inst = inst, prop = prop, on = false, val = default }
        -- PostEffect / Atmosphere は、ゲーム側にLightingを入れ替えられても再取得できるようクラス名を覚える
        pcall(function()
            if inst ~= Lighting and (inst:IsA("PostEffect") or inst:IsA("Atmosphere")) then o.cls = inst.ClassName end
        end)
        table.insert(overrides, o)
        return o
    end
    local function setOn(o, v)
        if v then
            local ok, cur = pcall(function() return o.inst[o.prop] end)
            if ok then o.orig, o.has = cur, true end
            o.on = true
        else
            o.on = false
            if o.has then
                pcall(function() o.inst[o.prop] = o.orig end)
                o.has = false
            end
        end
    end
    local function setGroup(list, v) for _, o in ipairs(list) do setOn(o, v) end end
    local fxByClass = {}
    local function ensureFx(cls, hint)
        local cur = fxByClass[cls] or hint
        if cur and cur.Parent == Lighting then fxByClass[cls] = cur return cur end
        for _, c in ipairs(Lighting:GetChildren()) do
            if c:IsA(cls) then fxByClass[cls] = c return c end
        end
        if cur and pcall(function() cur.Parent = Lighting end) then fxByClass[cls] = cur return cur end
        local ok, n = pcall(Instance.new, cls)
        if not ok then return cur end
        n.Name = "Kooa" .. cls
        pcall(function() if n:IsA("PostEffect") then n.Enabled = false end end)
        n.Parent = Lighting
        fxByClass[cls] = n
        return n
    end
    local function applyOverrides()
        for _, o in ipairs(overrides) do
            if o.on then
                pcall(function()
                    if o.cls then
                        local inst = ensureFx(o.cls, o.inst)
                        if inst and inst ~= o.inst then o.inst = inst end
                    end
                    if o.inst[o.prop] ~= o.val then o.inst[o.prop] = o.val end
                end)
            end
        end
    end
