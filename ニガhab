-- 起動ガード (重複実行防止 / 非対応エクスキューター拒否)
-- ============================================
do
    local genv = getgenv()
    local jobKey = (game.JobId ~= "" and game.JobId) or "local"
    if genv.KooaLoaded == jobKey then
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", { Title = "kooa", Text = "すでに実行されています", Duration = 4 })
        end)
        return
    end

    local execName = "unknown"
    pcall(function() if identifyexecutor then execName = tostring((identifyexecutor())) end end)
    local lname = execName:lower()
    if lname:find("xeno", 1, true) or lname:find("solara", 1, true) then
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", { Title = "kooa", Text = execName .. " は非対応です", Duration = 6 })
        end)
        warn("[kooa] unsupported executor: " .. execName)
        return
    end

    genv.KooaLoaded = jobKey
end

