-- ------------------------------------------------
-- Screen Rain (画面に重ねる雨): パーティクルに依存しないので確実に表示される
-- ------------------------------------------------
do
    local PlayerGui = LP:WaitForChild("PlayerGui")
    local gui = Instance.new("ScreenGui")
    gui.Name = "KooaScreenRain"; gui.ResetOnSpawn = false; gui.IgnoreGuiInset = true
    gui.DisplayOrder = -50; gui.Enabled = false; gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = PlayerGui
    local SR = { on = false, count = 220, speed = 1, length = 26, alpha = 0.55, angle = 8 }
    local drops = {}
    local function style()
        for _, d in ipairs(drops) do
            d.f.Size = UDim2.fromOffset(math.max(1, math.floor(SR.length / 14)), SR.length * d.s)
            d.f.BackgroundTransparency = 1 - math.clamp(SR.alpha * (0.5 + 0.5 * d.s), 0, 1)
            d.f.Rotation = SR.angle
        end
    end
    local function build()
        for _, d in ipairs(drops) do d.f:Destroy() end
        drops = {}
        for i = 1, SR.count do
            local f = Instance.new("Frame")
            f.BorderSizePixel = 0; f.BackgroundColor3 = Color3.fromRGB(190, 210, 255)
            f.AnchorPoint = Vector2.new(0.5, 0.5); f.Parent = gui
            drops[i] = { f = f, x = math.random(), y = math.random(), s = 0.7 + math.random() * 0.6 }
        end
        style()
    end
    RunService.RenderStepped:Connect(function(dt)
        if not SR.on then return end
        if gui.Parent ~= PlayerGui then pcall(function() gui.Parent = PlayerGui end) end
        local cam = workspace.CurrentCamera
        local w = cam and cam.ViewportSize.X or 1000
        local drift = -math.sin(math.rad(SR.angle)) * 0.9 * SR.speed
        for _, d in ipairs(drops) do
            d.y = d.y + dt * 1.1 * SR.speed * d.s
            d.x = d.x + dt * drift * d.s * (400 / w) * 0.3
            if d.y > 1.05 then d.y = -0.05; d.x = math.random() end
            d.f.Position = UDim2.fromScale(d.x, d.y)
        end
    end)
    VisualRight2:AddToggle("ScreenRainToggle", { Text = "Screen Rain (overlay)", Default = false, Callback = function(v)
        SR.on = v; gui.Enabled = v
        if v and #drops ~= SR.count then build() end
    end })
    VisualRight2:AddSlider("ScreenRainCount", { Text = "Screen Rain Density", Min = 20, Max = 600, Default = SR.count, Rounding = 0, Callback = function(v)
        SR.count = v if SR.on then build() end
    end })
    VisualRight2:AddSlider("ScreenRainSpeed", { Text = "Screen Rain Speed", Min = 0.3, Max = 3, Default = SR.speed, Rounding = 2, Callback = function(v) SR.speed = v end })
    VisualRight2:AddSlider("ScreenRainLength", { Text = "Screen Rain Length", Min = 8, Max = 80, Default = SR.length, Rounding = 0, Callback = function(v) SR.length = v style() end })
    VisualRight2:AddSlider("ScreenRainAlpha", { Text = "Screen Rain Opacity", Min = 0.1, Max = 1, Default = SR.alpha, Rounding = 2, Callback = function(v) SR.alpha = v style() end })
    VisualRight2:AddSlider("ScreenRainAngle", { Text = "Screen Rain Angle", Min = -30, Max = 30, Default = SR.angle, Rounding = 0, Callback = function(v) SR.angle = v style() end })
    pcall(function() Library:OnUnload(function() gui:Destroy() end) end)
end

