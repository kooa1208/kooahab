-- ============================================
-- 試合検知 (Rivals内部のDuelController / FighterController を参照。Kiciaと同じ構造)
-- status: "lobby" / "pre"(武器選択・ラウンド前) / "round"(試合中) / "over"(終了)
-- ============================================
local Match = { status = "lobby", changedAt = tick(), cbs = {}, enemyList = {}, alive = true }
do
    pcall(function() Library:OnUnload(function() Match.alive = false end) end)
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local cache = {}
    local function mod(key, fn)
        if cache[key] then return cache[key] end
        local ok, m = pcall(function() return require(fn()) end)
        if ok and type(m) == "table" then cache[key] = m return m end
        return nil
    end
    local function get(t, k)
        if type(t) ~= "table" then return nil end
        local ok, v = pcall(rawget, t, k)
        if ok and v ~= nil then return v end
        ok, v = pcall(function() return t[k] end)
        if ok then return v end
        return nil
    end
    local function DC() return mod("DC", function() return LP.PlayerScripts.Controllers.DuelController end) end
    local function FC() return mod("FC", function() return LP.PlayerScripts.Controllers.FighterController end) end
    local function IL() return mod("IL", function() return ReplicatedStorage.Modules.ItemLibrary end) end

    local function localDuel()
        local objs = get(DC(), "Objects")
        if type(objs) ~= "table" then return nil end
        for _, duel in pairs(objs) do
            local ds = get(duel, "Duelers")
            if type(ds) == "table" then
                for _, d in pairs(ds) do
                    if get(d, "Player") == LP then return duel, d, ds end
                end
            end
        end
        return nil
    end

    local function computeStatus()
        local duel = localDuel()
        if not duel then return "lobby" end
        local st = get(get(duel, "Data"), "Status")
        if st == "RoundStarted" then return "round" end
        if st == "GameOver" then return "over" end
        return "pre"
    end

    function Match.enemies()
        local out = {}
        local duel, me, ds = localDuel()
        if not duel then return out end
        local myTeam = get(me, "TeamID")
        for _, d in pairs(ds) do
            local p = get(d, "Player")
            if typeof(p) == "Instance" and p ~= LP then
                local t = get(d, "TeamID")
                if myTeam == nil or t == nil or t ~= myTeam then out[#out + 1] = p end
            end
        end
        return out
    end

    -- 相手が今持っているアイテム: (Class, Name)  Class = Primary / Secondary / Melee / Utility
    function Match.held(plr)
        local objs = get(FC(), "Objects")
        if type(objs) ~= "table" then return nil end
        for _, f in pairs(objs) do
            if get(f, "Player") == plr then
                local item = get(f, "EquippedItem")
                if not item then return "none", nil end
                local name = get(get(item, "Data"), "Name")
                if not name then return nil end
                local info = get(get(IL(), "Items"), name)
                return get(info, "Class") or "?", name
            end
        end
        return nil
    end

    local last = "lobby"
    task.spawn(function()
        while Match.alive do
            task.wait(0.25)
            local ok, st = pcall(computeStatus)
            if ok and st then
                if st ~= last then
                    local old = last
                    last = st
                    Match.status = st
                    Match.changedAt = tick()
                    for _, cb in ipairs(Match.cbs) do task.spawn(function() pcall(cb, st, old) end) end
                end
                local ok2, list = pcall(Match.enemies)
                Match.enemyList = (ok2 and st ~= "lobby") and list or {}
            end
        end
    end)
end


