    ScreenGui.Name = "KooaCrosshair"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.DisplayOrder = 9999
    ScreenGui.Enabled = false
    local okParent = pcall(function() ScreenGui.Parent = TargetGui end)
    if not okParent or not ScreenGui.Parent then ScreenGui.Parent = LP:WaitForChild("PlayerGui") end

    local CenterContainer = Instance.new("Frame")
    CenterContainer.Name = "Center"
    CenterContainer.Size = UDim2.fromOffset(0, 0)
    CenterContainer.Position = UDim2.fromScale(0.5, 0.5)
    CenterContainer.AnchorPoint = Vector2.new(0, 0)
    CenterContainer.BackgroundTransparency = 1
    CenterContainer.BorderSizePixel = 0
    CenterContainer.Parent = ScreenGui

    local IS_MOBILE = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

    local CFG = {
        Length = 17, Thick = 2, Gap = 8,
        RotSpd = 150, PulseSpd = 3.5, SizeRng = 5,
        RGBSpeed = 0.12, GlowMult = 3.2,
        TextGap = 7, TextSizeMobile = 16, TextSizePC = 12,
    }
    local Transparencies = {0.66, 0.75, 0.84, 0.91, 0.97}
    local DIRECTIONS = {Vector2.new(0,-1), Vector2.new(0,1), Vector2.new(-1,0), Vector2.new(1,0)}
    local Components = {}
    local RNG = Random.new()

    for i, dir in ipairs(DIRECTIONS) do
        local isHoriz = dir.X ~= 0

        local Outline = Instance.new("Frame")
        Outline.Name = string.format("Outline_%d", i)
        Outline.BorderSizePixel = 0
        Outline.BackgroundColor3 = Color3.new(0,0,0)
        Outline.BackgroundTransparency = 0.5
        Outline.AnchorPoint = Vector2.new(0.5, 0.5)
        Outline.ZIndex = 10
        Outline.Parent = CenterContainer

        local Line = Instance.new("Frame")
        Line.Name = string.format("Line_%d", i)
        Line.BorderSizePixel = 0
        Line.AnchorPoint = Vector2.new(0.5, 0.5)
        Line.ZIndex = 11
        Line.Parent = CenterContainer

        local Layers = {}
        for step, trans in ipairs(Transparencies) do
            local Glow = Instance.new("Frame")
            Glow.Name = string.format("Glow_%d_%d", i, step)
            Glow.BorderSizePixel = 0
            Glow.AnchorPoint = Vector2.new(0.5, 0.5)
            Glow.BackgroundColor3 = Color3.new(1,1,1)
            Glow.BackgroundTransparency = trans
            Glow.ZIndex = step
            Glow.Parent = CenterContainer
            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(1, 0)
            Corner.Parent = Glow
            table.insert(Layers, Glow)
        end

        table.insert(Components, { Line = Line, Outline = Outline, Glows = Layers, Dir = dir, IsHorizontal = isHoriz })
    end

    -- 名前表示 (デフォルトは空 = 非表示。テキストボックスで好きな名前に変更)
    local Watermark = Instance.new("TextLabel")
    Watermark.Name = "CrosshairName"
    Watermark.Text = ""
    Watermark.Visible = false
    Watermark.Font = Enum.Font.RobotoMono
    Watermark.TextSize = IS_MOBILE and CFG.TextSizeMobile or CFG.TextSizePC
    Watermark.Size = UDim2.fromOffset(IS_MOBILE and 125 or 100, IS_MOBILE and 22 or 18)
    Watermark.AnchorPoint = Vector2.new(0.5, 0)
    Watermark.BackgroundTransparency = 1
    Watermark.BorderSizePixel = 0
    Watermark.TextXAlignment = Enum.TextXAlignment.Center
    Watermark.TextYAlignment = Enum.TextYAlignment.Center
    Watermark.TextColor3 = Color3.new(1,1,1)
    Watermark.ZIndex = 12
    Watermark.Parent = ScreenGui

    local TextStroke = Instance.new("UIStroke")
    TextStroke.Color = Color3.new(0,0,0)
    TextStroke.Thickness = 1
    TextStroke.Transparency = 0.2
    TextStroke.Parent = Watermark

    local TickCounter, SmoothRot = 0, 0
    RunService.RenderStepped:Connect(function(dt)
        if not CrosshairEnabled or not ScreenGui.Parent then return end
        TickCounter += dt
        CenterContainer.Position = UDim2.fromScale(0.5, 0.5)

        local Pulse = math.sin(TickCounter * CFG.PulseSpd)
        local DynamicLength = CFG.Length + Pulse * CFG.SizeRng

        SmoothRot = (SmoothRot + CFG.RotSpd * (0.35 + ((Pulse + 1) * 0.5 * (1.75 - 0.35))) * dt) % 360
        CenterContainer.Rotation = SmoothRot

        local CurrentColor = Color3.fromHSV((TickCounter * CFG.RGBSpeed) % 1, 1, 1)
        local ScatX = RNG:NextNumber(-0.35, 0.35)
        local ScatY = RNG:NextNumber(-0.35, 0.35)

        for _, comp in ipairs(Components) do
            local centerOffset = CFG.Gap + DynamicLength * 0.5
            local posX = comp.Dir.X * centerOffset
            local posY = comp.Dir.Y * centerOffset
            local sizeW = comp.IsHorizontal and DynamicLength or CFG.Thick
            local sizeH = comp.IsHorizontal and CFG.Thick or DynamicLength

            comp.Line.Size = UDim2.fromOffset(sizeW, sizeH)
            comp.Line.Position = UDim2.fromOffset(posX, posY)
            comp.Line.BackgroundColor3 = CurrentColor

            comp.Outline.Size = UDim2.fromOffset(sizeW + (comp.IsHorizontal and 0 or 2), sizeH + (comp.IsHorizontal and 2 or 0))
            comp.Outline.Position = UDim2.fromOffset(posX, posY)

            for step, glow in ipairs(comp.Glows) do
                local spread = step * CFG.GlowMult
                local gW = sizeW + (comp.IsHorizontal and spread * 0.2 or spread) + (comp.IsHorizontal and ScatY or ScatX)
                local gH = sizeH + (comp.IsHorizontal and spread or spread * 0.2) + (comp.IsHorizontal and ScatX or ScatY)
                glow.Size = UDim2.fromOffset(gW, gH)
                glow.Position = UDim2.fromOffset(
                    posX + (comp.IsHorizontal and ScatY * 0.2 or ScatX),
                    posY + (comp.IsHorizontal and ScatX or ScatY * 0.2)
                )
                glow.BackgroundColor3 = CurrentColor
            end
        end

        Watermark.Position = UDim2.new(0.5, 0, 0.5, CFG.Gap + DynamicLength + CFG.TextGap)
        Watermark.TextColor3 = CurrentColor
    end)

