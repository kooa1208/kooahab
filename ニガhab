-- ------------------------------------------------
-- Walk Speed : Kicia と同じ方式
--   MechanicsController の _GetWalkSpeed が参照する BASE_WALKSPEED(upvalue) を
--   倍率つきのテーブルに差し替える (Humanoid.WalkSpeed は触らない)
-- ------------------------------------------------
pcall(function() if getgenv().KooaWalkRestore then getgenv().KooaWalkRestore() end end) -- 再実行時に前回のフックを元に戻す

local WalkHook = { loaded = false, fn = nil, upvalueIndex = nil, oldUpvalue = nil,
    enabled = false, mult = 1.5, slideEnabled = false, slideMult = 1.5 }

local function walkNotify(msg, silent)
    warn("[kooa] WalkSpeed: " .. msg)
    if not silent then pcall(function() Library:Notify("WalkSpeed: " .. msg, 5) end) end
end

local function findWalkUpvalue(fn)
    local ok, ups = pcall(debug.getupvalues, fn)
    if not ok or type(ups) ~= "table" then return nil end
    for k, v in pairs(ups) do
        if type(v) == "table" and rawget(v, "BASE_WALKSPEED") ~= nil then return k end
    end
    return nil
end

-- Rivals以外 (MechanicsControllerが無いマップ) は Humanoid.WalkSpeed で変更する
local function useHumanoidMode(silent)
    if not WalkHook.humanoid then
        WalkHook.humanoid = true
        walkNotify("Rivals以外のため通常のWalkSpeed方式を使います", silent)
    end
    return false
end

local function walkLoadHook(silent)
    if WalkHook.loaded then return true end
    local ps = LP:FindFirstChild("PlayerScripts")
    local controllers = ps and ps:FindFirstChild("Controllers")
    local mcInst = controllers and controllers:FindFirstChild("MechanicsController")
    if not mcInst then return useHumanoidMode(silent) end

    local okMc, mc = pcall(require, mcInst)
    if not okMc or type(mc) ~= "table" then return useHumanoidMode(silent) end
    local meta = getmetatable(mc)
    local idx = meta ~= nil and rawget(meta, "__index") or nil
    if type(idx) ~= "table" then return useHumanoidMode(silent) end

    local fn, found = rawget(idx, "_GetWalkSpeed"), nil
    if type(fn) == "function" then found = findWalkUpvalue(fn) end
    if not found then
        for _, f in pairs(idx) do
            if type(f) == "function" then
                local k = findWalkUpvalue(f)
                if k then fn, found = f, k break end
            end
        end
    end
    if not found then return useHumanoidMode(silent) end

    local old = debug.getupvalue(fn, found)
    WalkHook.fn, WalkHook.upvalueIndex, WalkHook.oldUpvalue = fn, found, old
    debug.setupvalue(fn, found, setmetatable({}, { __index = function(_, key)
        if key == "BASE_WALKSPEED" then
            local base = rawget(old, "BASE_WALKSPEED")
            if WalkHook.slideEnabled and debug.info(3, "n") == "Slide" then
                return base * WalkHook.slideMult
            end
            if WalkHook.enabled then
                return base * WalkHook.mult
            end
            return base
        end
        return rawget(old, key)
    end }))
    WalkHook.loaded = true

    local function restore()
        pcall(debug.setupvalue, fn, found, old)
        WalkHook.loaded = false
    end
    getgenv().KooaWalkRestore = restore
    pcall(function() Library:OnUnload(restore) end)
    return true
end

