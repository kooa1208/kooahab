        cur = cur.Parent
    end
    local m = part
    while m.Parent and m.Parent ~= fp do m = m.Parent end
    if m.Parent == fp and (m.Name:lower():find("arm") or m.Name:lower():find("glove")) then if not wireCfg.arms.on then return nil end return {Color=wireCfg.arms.color, Width=wireCfg.arms.width, Transparency=0.02} end
