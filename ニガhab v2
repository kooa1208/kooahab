        end
        -- 硬い輪っかではなく、重ねた円でふんわりしたグロー(にじみ)にする
        local halo = Instance.new("Frame")
        halo.BackgroundTransparency = 1; halo.BorderSizePixel = 0
        halo.AnchorPoint = Vector2.new(0.5, 0.5); halo.ZIndex = 1; halo.Visible = false; halo.Parent = gui
        local glowLayers = {}
        for i = 1, 8 do
