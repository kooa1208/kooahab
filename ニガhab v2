local function resolveSoundId(name, custom)
    custom = tostring(custom or ""):gsub("%s+", "")
    if custom ~= "" then
        if custom:match("^%d+$") then return "rbxassetid://" .. custom end
        return custom
    end
    return sfxMap[name]
end

local function playSfx(id, volume, pitch)
    if not id then return end
    local s = Instance.new("Sound")
    s.Name = "KooaSfx"
    s.SoundId = id
    s.Volume = volume
    s.PlaybackSpeed = pitch
    s.Parent = SoundService
    s.Ended:Once(function() s:Destroy() end)
    s:Play()
    task.delay(6, function() if s.Parent then s:Destroy() end end)
end

