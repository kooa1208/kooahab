-- コマンド処理: "c" = ブラックリスト追加(赤) / "t" = 解除
local function findTarget(query)
    query = query:lower()
    if query == "" then return BL.selected end
    if query:match("^%d+$") then return query end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower():find(query, 1, true) or plr.DisplayName:lower():find(query, 1, true) then
            return tostring(plr.UserId)
        end
    end
    for uid, info in pairs(BL.players) do
        if (info.name or ""):lower():find(query, 1, true) or (info.display or ""):lower():find(query, 1, true) then
            return uid
        end
    end
    return nil
end

local function blAdd(uid)
    local plr = Players:GetPlayerByUserId(tonumber(uid))
    local old = BL.players[uid] or {}
    BL.players[uid] = { name = plr and plr.Name or old.name or uid, display = plr and plr.DisplayName or old.display or "" }
    blSave(); refreshList()
end
local function blRemove(uid)
    BL.players[uid] = nil
    blSave(); refreshList()
end

local function blDisplayName(uid)
    local plr = Players:GetPlayerByUserId(tonumber(uid))
    local info = BL.players[uid]
    return plr and plr.Name or (info and info.name) or uid
end

local function runCommand(text)
    text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" then return end
    local cmd, rest = text:match("^(%a)$"), ""
    if not cmd then cmd, rest = text:match("^(%a)%s+(.+)$") end
    cmd = cmd and cmd:lower()
    if cmd ~= "c" and cmd ~= "t" then
        Library:Notify("c = 赤にする / t = 解除  (例: c  /  c 名前)", 4)
        return
    end
    local uid = findTarget(rest or "")
    if not uid then
        Library:Notify(rest ~= "" and "プレイヤーが見つかりません" or "先に一覧からプレイヤーを選んでください", 4)
        return
    end
    if uid == tostring(LP.UserId) then Library:Notify("自分は対象にできません", 3) return end
    if cmd == "c" then
        blAdd(uid); Library:Notify("Blacklist: " .. blDisplayName(uid) .. " を赤にしました", 3)
    else
        local nm = blDisplayName(uid)
        blRemove(uid); Library:Notify("Blacklist: " .. nm .. " を解除しました", 3)
    end
end

