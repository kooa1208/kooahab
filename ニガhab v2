-- ----- 名前 : 画面上の文字をイベントで即置き換え -----
local textObjs = setmetatable({}, { __mode = "k" })
local textRec  = setmetatable({}, { __mode = "k" })     -- obj -> { orig, last }
local humOrig  = setmetatable({}, { __mode = "k" })     -- Humanoid -> 元のDisplayName
local nameMap = {}

local function isWordChar(c) return c ~= "" and c:match("[%w_]") ~= nil end

-- 大文字小文字を区別せず置換 (日本語など英数字以外の名前にも対応)
local function replaceCI(text, find, repl)
    if find == "" then return text end
    local lt, lf = text:lower(), find:lower()
    local out, pos = {}, 1
    local needL = isWordChar(find:sub(1, 1))
    local needR = isWordChar(find:sub(-1))
    while true do
        local st, en = lt:find(lf, pos, true)
        if not st then break end
        local okL = (not needL) or (st == 1) or not isWordChar(text:sub(st - 1, st - 1))
        local okR = (not needR) or not isWordChar(text:sub(en + 1, en + 1))
        if okL and okR then
            local matched = text:sub(st, en)
            local r = repl
            if matched == matched:upper() and matched ~= matched:lower() then r = repl:upper() end
            table.insert(out, text:sub(pos, st - 1)); table.insert(out, r)
            pos = en + 1
        else
            table.insert(out, text:sub(pos, st)); pos = st + 1
        end
    end
    table.insert(out, text:sub(pos))
    return table.concat(out)
end

local function rebuildNameMap()
    local list = {}
    local function add(plr, cfg)
        if cfg.name and cfg.nameV ~= "" then
            table.insert(list, { plr.Name, cfg.nameV })
            if plr.DisplayName ~= plr.Name then table.insert(list, { plr.DisplayName, cfg.nameV }) end
        end
    end
    add(LP, SP.me)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then add(plr, SP.opp) end
    end
    nameMap = list
end

local function isOurGui(o)
    for _, n in ipairs({ "KooaStats", "KooaBlacklist" }) do
        if o:FindFirstAncestor(n) then return true end
    end
    local ok, sg = pcall(function() return Library.ScreenGui end)
    if ok and sg and o:IsDescendantOf(sg) then return true end
    return false
end

local function applyOne(obj)
    if not obj.Parent then return end
    local rec = textRec[obj]
    local cur = obj.Text
    if #nameMap == 0 and not rec then return end
    local base = (rec and cur == rec.last) and rec.orig or cur
    local out = base
    for _, m in ipairs(nameMap) do out = replaceCI(out, m[1], m[2]) end
    if out ~= base then
        if cur ~= out then obj.Text = out end
        textRec[obj] = { orig = base, last = out }
    elseif rec then
        if cur == rec.last then obj.Text = rec.orig end
        textRec[obj] = nil
    end
end

local function trackText(o)
    if (o:IsA("TextLabel") or o:IsA("TextButton")) and not textObjs[o] then
