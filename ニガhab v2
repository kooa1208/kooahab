-- Rage検知: 相手の位置を毎フレーム追跡
local track, lastNotify = {}, {}
RunService.Heartbeat:Connect(function(dt)
    local notifyOn = tog("RageDetect")
    if not (notifyOn or tog("RageAutoLoad") or tog("RageAutoBlacklist")) then return end
    local st = Match.status
    if (st ~= "pre" and st ~= "round") or tick() - Match.changedAt < 3 or dt > 0.1 then
        table.clear(track)
        return
    end
    local limit = (st == "round") and opt("RageSpeedRound", 90) or opt("RageSpeedPre", 30)
    local warpDist = (st == "round") and 35 or 12
    local now = tick()
    for _, plr in ipairs(Match.enemyList) do
        local ch = plr.Character
        local hrp = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
        if hrp then
            local p = hrp.Position
            local tr = track[plr]
            if tr and tr.hrp == hrp then
                local d = (p - tr.pos).Magnitude
                tr.acc = tr.acc + d
                tr.time = tr.time + dt
                local warp = d > warpDist
                local fast = false
                if tr.time >= 0.5 then
                    fast = (tr.acc / tr.time) > limit
                    tr.acc, tr.time = 0, 0
                end
                if (warp or fast) and now - (lastNotify[plr] or 0) > 4 then
                    lastNotify[plr] = now
                    local why = warp and "ワープ" or "高速移動"
                    if notifyOn then
                        Library:Notify(string.format("Rage検知: %s (%s)", plr.DisplayName, why), 5)
                    end
                    rageAutoLoad(plr, why)
                    rageAutoBlacklist(plr, why)
                end
                tr.pos = p
            else
                track[plr] = { pos = p, hrp = hrp, acc = 0, time = 0 }
            end
        end
    end
end)

