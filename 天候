-- ============================================
-- 天候システム（雨・雪）
-- ============================================
local weatherParts = {}
local weatherActive = false
local currentWeather = "none"
local weatherConnection = nil
local rainSettings = { intensity = 1, dropSize = 1, dropSpeed = 1 }
local snowSettings = { intensity = 1, flakeSize = 0.5, fallSpeed = 1 }

local function clearWeather()
    if weatherConnection then weatherConnection:Disconnect() weatherConnection = nil end
    for _, part in pairs(weatherParts) do if part and part.Parent then part:Destroy() end end
    weatherParts = {}
    weatherActive = false
    currentWeather = "none"
end

local function createRain()
    clearWeather()
    currentWeather = "rain"
    weatherActive = true
    local dropVector = Vector3.new(20, -150, 10)
    weatherConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not weatherActive or currentWeather ~= "rain" then return end
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local root = char.HumanoidRootPart
        local dropCount = math.floor(90 * rainSettings.intensity * deltaTime * 10)
        for i = 1, math.max(1, dropCount) do
            local drop = Instance.new("Part")
            drop.Size = Vector3.new(0.05 * rainSettings.dropSize, 2.5 * rainSettings.dropSize, 0.05 * rainSettings.dropSize)
            drop.Shape = Enum.PartType.Cylinder
            local spawnPos = root.Position + Vector3.new(math.random(-40, 40), 45, math.random(-40, 40))
            local targetPos = spawnPos + dropVector
            drop.Position = spawnPos
            drop.Color = Color3.fromRGB(255,255,255)
            drop.Transparency = 0.35
            drop.Anchored = true
            drop.CanCollide = false
            drop.Material = Enum.Material.Neon
            drop.Parent = workspace
            local fallTime = (0.5 / rainSettings.dropSpeed)
            TweenService:Create(drop, TweenInfo.new(fallTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = targetPos}):Play()
            task.delay(fallTime + 0.5, function() if drop and drop.Parent then drop:Destroy() end end)
            table.insert(weatherParts, drop)
        end
    end)
end

local function createSnow()
    clearWeather()
    currentWeather = "snow"
    weatherActive = true
    local snowVector = Vector3.new(8, -120, 5)
    weatherConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not weatherActive or currentWeather ~= "snow" then return end
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local root = char.HumanoidRootPart
        local flakeCount = math.floor(40 * snowSettings.intensity * deltaTime * 10)
        for i = 1, math.max(1, flakeCount) do
            local flake = Instance.new("Part")
            local size = (math.random(30, 150) / 100) * snowSettings.flakeSize
            flake.Size = Vector3.new(size, size, size)
            flake.Shape = Enum.PartType.Ball
            local spawnPos = root.Position + Vector3.new(math.random(-40, 40), 30, math.random(-40, 40))
            local targetPos = spawnPos + snowVector
            flake.Position = spawnPos
            flake.Color = Color3.fromRGB(255, 255, 255)
            flake.Transparency = 0.3
            flake.Material = Enum.Material.Neon
            flake.Reflectance = 0.5
            flake.Anchored = true
            flake.CanCollide = false
            flake.Parent = workspace
            local fallTime = (1.0 / snowSettings.fallSpeed)
            TweenService:Create(flake, TweenInfo.new(fallTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = targetPos}):Play()
            task.delay(fallTime + 0.5, function() if flake and flake.Parent then flake:Destroy() end end)
            table.insert(weatherParts, flake)
        end
    end)
end

-- スクリーンティント
local tintConnection = nil
local currentTint = "NONE"
local tintColors = { PURPLE = Color3.fromRGB(150, 120, 220), GREEN = Color3.fromRGB(150, 220, 150), PINK = Color3.fromRGB(255, 150, 200), WHITE = Color3.fromRGB(255, 255, 255) }
local function applyTint(colorName)
    if tintConnection then tintConnection:Destroy() tintConnection = nil end
    if colorName == "NONE" then currentTint = "NONE" return end
    local color = tintColors[colorName]
    if not color then currentTint = "NONE" return end
    tintConnection = Instance.new("ColorCorrectionEffect")
    tintConnection.Name = "ScreenTint"
    tintConnection.TintColor = color
    tintConnection.Saturation = 0.6
    tintConnection.Parent = Lighting
    currentTint = colorName
end

