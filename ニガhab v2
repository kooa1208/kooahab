local function wClear(part) if wObjects[part] then wObjects[part].Adornment:Destroy() wObjects[part] = nil end end
local function wClassify(part)
    local fp = workspace:FindFirstChild("ViewModels") and workspace.ViewModels:FindFirstChild("FirstPerson")
    if not fp or not part:IsDescendantOf(fp) then return nil end
    local cur = part
    while cur and cur ~= fp do
