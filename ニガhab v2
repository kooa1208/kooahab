do
local P=game:GetService("Players")local R=game:GetService("RunService")local p=P.LocalPlayer local c=workspace.CurrentCamera local F={} _G.FlyAPI=F
F.Enabled=false F.IsFlying=false F.Speed=100 F.Turn=14 F.Override=nil
F.Started=Instance.new("BindableEvent")F.Stopped=Instance.new("BindableEvent")F.StateChanged=Instance.new("BindableEvent")
local ctl pcall(function()ctl=require(p:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()end)
local cn,bv,bg,ch
local function restoreHum()
    if ch then local h=ch:FindFirstChildOfClass("Humanoid")if h then h.PlatformStand=false h.AutoRotate=true end end
end
local function dc()if cn then cn:Disconnect()cn=nil end if bv then bv:Destroy()bv=nil end if bg then bg:Destroy()bg=nil end end
local function sf(s)if F.IsFlying==s then return end F.IsFlying=s if s then F.Started:Fire()else F.Stopped:Fire()end F.StateChanged:Fire(s)end
local function st(char)
    dc()ch=char
    local r=char:WaitForChild("HumanoidRootPart")local h=char:WaitForChild("Humanoid")
    if not F.Enabled then return end
    h.PlatformStand=true h.AutoRotate=false
    bv=Instance.new("BodyVelocity")bv.MaxForce=Vector3.new(1e9,1e9,1e9)bv.Velocity=Vector3.zero bv.Parent=r
    bg=Instance.new("BodyGyro")bg.MaxTorque=Vector3.new(1e9,1e9,1e9)bg.P=1e4 bg.D=500 bg.CFrame=r.CFrame bg.Parent=r
    local f=r.CFrame.LookVector
    cn=R.RenderStepped:Connect(function(dt)
        if not r.Parent then return end
        c=workspace.CurrentCamera
        if not F.Enabled then bv.Velocity=Vector3.zero sf(false)return end
        local d=nil
        if F.Override and F.Override.Magnitude>0.01 then d=F.Override.Unit
        else
            local m=ctl and ctl:GetMoveVector()or Vector3.zero
            if m.Magnitude>0.05 then
                local cf=c.CFrame
                local v=cf.LookVector*-m.Z+cf.RightVector*m.X
                if v.Magnitude>0.01 then d=v.Unit bv.Velocity=d*F.Speed*math.min(m.Magnitude,1)sf(true)end
            end
        end
        if d then
            if F.Override and F.Override.Magnitude>0.01 then bv.Velocity=d*F.Speed sf(true)end
            local nf=f:Lerp(d,math.clamp(F.Turn*dt,0,1))
            f=(nf.Magnitude>0.01)and nf.Unit or d
        else bv.Velocity=Vector3.zero sf(false)end
        bg.CFrame=CFrame.lookAt(r.Position,r.Position+f)
    end)
end
function F.SetEnabled(v)
    F.Enabled=(v and true)or false
    if F.Enabled then
        if p.Character then task.spawn(st,p.Character)end
    else
        sf(false)dc()restoreHum()
    end
    F.StateChanged:Fire(F.Enabled)
end
function F.Toggle()F.SetEnabled(not F.Enabled)end
function F.SetSpeed(v)F.Speed=tonumber(v)or F.Speed end
function F.SetTurn(v)F.Turn=tonumber(v)or F.Turn end
function F.SetDirection(v)F.Override=v end
function F.Destroy()dc()restoreHum()end
p.CharacterAdded:Connect(function(char)if F.Enabled then task.spawn(st,char)end end)
end

