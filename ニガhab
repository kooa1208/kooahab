local wObjects = {}
local edges = {{1,2},{2,4},{4,3},{3,1},{5,6},{6,8},{8,7},{7,5},{1,5},{2,6},{3,7},{4,8}}
local function wClear(part) if wObjects[part] then wObjects[part].Adornment:Destroy() wObjects[part] = nil end end
local function wClassify(part)
    local fp = workspace:FindFirstChild("ViewModels") and workspace.ViewModels:FindFirstChild("FirstPerson")
    if not fp or not part:IsDescendantOf(fp) then return nil end
    local cur = part
    while cur and cur ~= fp do
        local n = cur.Name:lower()
        if n == "itemvisual" or n == "itemmodel" then if not wireCfg.item.on then return nil end return {Color=wireCfg.item.color, Width=wireCfg.item.width, Transparency=0.02} end
        cur = cur.Parent
    end
    local m = part
    while m.Parent and m.Parent ~= fp do m = m.Parent end
    if m.Parent == fp and (m.Name:lower():find("arm") or m.Name:lower():find("glove")) then if not wireCfg.arms.on then return nil end return {Color=wireCfg.arms.color, Width=wireCfg.arms.width, Transparency=0.02} end
    return nil
end
local function wUpdate(part)
    if not part:IsA("BasePart") then return end
    local cfg = wClassify(part)
    if not cfg or part.Transparency >= 1 then wClear(part) return end
    local e = wObjects[part]
    if not e then
        local adorn = Instance.new("WireframeHandleAdornment"); adorn.Adornee = part; adorn.AlwaysOnTop = true; adorn.Parent = workspace.CurrentCamera or LP:FindFirstChildOfClass("PlayerGui")
        e = {Adornment=adorn}; wObjects[part] = e
