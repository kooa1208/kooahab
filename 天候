local currentWeatherType = "none"

local function updateWeatherButtons()
    local buttons = {rainButton, snowButton, noneWeatherButton}
    local types = {"rain", "snow", "none"}
    for i, button in ipairs(buttons) do
        if currentWeatherType == types[i] then button.BackgroundColor3 = Color3.fromRGB(55,55,65); button.TextColor3 = Color3.fromRGB(255,255,255)
        else button.BackgroundColor3 = Color3.fromRGB(35,35,40); button.TextColor3 = Color3.fromRGB(150,150,170) end
    end
end

