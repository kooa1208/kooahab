-- ============================================
-- ESPシステム（個別トグル対応）
-- ============================================
local espConfig = { highlight = false, line = false, name = false, distance = false }
local espColor = Color3.fromRGB(255, 255, 255)
local espObjects = {}

local function clearEsp()
    for _, obj in pairs(espObjects) do if obj and obj.Parent then obj:Destroy() end end
    espObjects = {}
end

local espLoopConnection = nil

local function updateEsp()
    clearEsp()
    
    -- もし全部OFFならループも止める
    if not (espConfig.highlight or espConfig.line or espConfig.name or espConfig.distance) then
        if espLoopConnection then espLoopConnection:Disconnect() espLoopConnection = nil end
        return
    end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    -- 常時更新用のループ（名前の距離を更新するため）
    if not espLoopConnection then
        espLoopConnection = RunService.RenderStepped:Connect(function()
            if not (espConfig.highlight or espConfig.line or espConfig.name or espConfig.distance) then return end
            local charNow = LocalPlayer.Character
            if not charNow or not charNow:FindFirstChild("HumanoidRootPart") then return end
            local root = charNow.HumanoidRootPart
            
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local targetRoot = player.Character.HumanoidRootPart
                    -- ビームと距離の更新
                    if espConfig.line then
                        for _, obj in pairs(espObjects) do
                            if obj.Name == "ESP_Beam_" .. player.Name then
                                obj.Attachment0.WorldPosition = root.Position + Vector3.new(0, 2, 0)
                                obj.Attachment1.WorldPosition = targetRoot.Position + Vector3.new(0, 2, 0)
                            end
                        end
                    end
                    if espConfig.distance then
                        local distance = (root.Position - targetRoot.Position).Magnitude
                        for _, obj in pairs(espObjects) do
                            if obj.Name == "ESP_Dist_" .. player.Name then
                                obj.Text = "距離: " .. string.format("%.0f", distance)
                            end
                        end
                    end
                end
            end
        end)
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = player.Character.HumanoidRootPart
            local head = player.Character:FindFirstChild("Head") or targetRoot
            
            -- 1. キャラ全体（ハイライト）
            if espConfig.highlight then
                local highlight = Instance.new("Highlight")
                highlight.FillColor = espColor
                highlight.FillTransparency = 0.7
                highlight.OutlineColor = espColor
                highlight.OutlineTransparency = 0
                highlight.Parent = player.Character
                table.insert(espObjects, highlight)
            end
            
            -- 2. 線（ビーム）
            if espConfig.line then
                local attachment1 = Instance.new("Attachment")
                attachment1.Position = Vector3.new(0, 2, 0)
                attachment1.Parent = char.Head or char.HumanoidRootPart
                local attachment2 = Instance.new("Attachment")
                attachment2.Position = Vector3.new(0, 2, 0)
                attachment2.Parent = head
                local beam = Instance.new("Beam")
                beam.Name = "ESP_Beam_" .. player.Name
                beam.Attachment0 = attachment1
                beam.Attachment1 = attachment2
                beam.Color = ColorSequence.new(espColor)
                beam.LightEmission = 0.5
                beam.Width0 = 0.1
                beam.Width1 = 0.1
                beam.Parent = workspace
                table.insert(espObjects, beam)
                table.insert(espObjects, attachment1)
                table.insert(espObjects, attachment2)
            end
            
            -- 3・4. 名前と距離
            if espConfig.name or espConfig.distance then
                local billboard = Instance.new("BillboardGui")
                billboard.Size = UDim2.new(0, 150, 0, 40)
                billboard.AlwaysOnTop = true
                billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0)
                billboard.Parent = head
                table.insert(espObjects, billboard)
                
                if espConfig.name then
                    local nameLabel = Instance.new("TextLabel")
                    nameLabel.Size = UDim2.new(1, 0, 0, 20)
                    nameLabel.BackgroundTransparency = 1
                    nameLabel.Text = player.Name
                    nameLabel.Font = Enum.Font.GothamBold
                    nameLabel.TextSize = 12
                    nameLabel.TextColor3 = espColor
                    nameLabel.TextStrokeTransparency = 0.5
                    nameLabel.Parent = billboard
                    table.insert(espObjects, nameLabel)
                end
                
                if espConfig.distance then
                    local distLabel = Instance.new("TextLabel")
                    distLabel.Name = "ESP_Dist_" .. player.Name
                    distLabel.Size = UDim2.new(1, 0, 0, 20)
                    distLabel.Position = UDim2.new(0, 0, 0, 20)
                    distLabel.BackgroundTransparency = 1
                    distLabel.Text = "距離: 計算中..."
                    distLabel.Font = Enum.Font.Gotham
                    distLabel.TextSize = 10
                    distLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    distLabel.Parent = billboard
                    table.insert(espObjects, distLabel)
                end
            end
        end
    end
end

