local ralLoaded, ralLast = false, 0
local function rageAutoLoad(plr, why)
    if not RAL.enabled or RAL.config == "" then return end
    if RAL.once and ralLoaded then return end
    if tick() - ralLast < RAL.cooldown then return end
    ralLoaded, ralLast = true, tick()
    task.spawn(function()
        local ok, a, b = pcall(function() return SaveManager:Load(RAL.config) end)
        pcall(function() if Library.__kooaKillEffectPreload then Library.__kooaKillEffectPreload() end end)
        if ok and a ~= false then
            pcall(function() Library:Notify(string.format("Rage検知(%s: %s) → コンフィグ '%s' をロードしました", why, plr.DisplayName, RAL.config), 6) end)
        else
            ralLoaded = false
            pcall(function() Library:Notify("Rage自動ロード失敗: " .. tostring(ok and b or a), 6) end)
        end
    end)
end
