-- World タブの各設定 (Skybox / Lighting / Bloom / Atmosphere / Color / Weather) をまとめてON+値設定します
do
    local function setT(id, v) local t = Library.Toggles[id] if t then pcall(function() t:SetValue(v) end) end end
    local function setO(id, v) local o = Library.Options[id] if o then pcall(function() o:SetValue(v) end) end end
    local function setC(id, c)
        local o = Library.Options[id]
        if o then pcall(function() if o.SetValueRGB then o:SetValueRGB(c) else o:SetValue(c) end end) end
    end
    local function apply(on)
        setT("SkyboxToggle", on)
        if on then setO("SkyboxPreset", "PurpleMoon") end

        setC("LAmbientC1", Color3.fromRGB(45, 50, 150)); setC("LAmbientC2", Color3.fromRGB(25, 25, 110)); setT("LAmbientOn", on)
        setC("LShiftBottomC1", Color3.fromRGB(20, 20, 110)); setT("LShiftBottomOn", on)
        setC("LShiftTopC1", Color3.fromRGB(70, 90, 210)); setT("LShiftTopOn", on)
        setC("LFogColorC1", Color3.fromRGB(30, 30, 120)); setT("LFogColorOn", on)
        setO("LFogEndVal", 700); setT("LFogEndOn", on)
        setO("LFogStartVal", 40); setT("LFogStartOn", on)
        setO("LBrightnessVal", 1.6); setT("LBrightnessOn", on)
