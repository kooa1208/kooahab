local attrOrig = setmetatable({}, { __mode = "k" })
local function setSpoofAttr(plr, attr, enabled, value)
    local store = attrOrig[plr]
    if not store then store = {}; attrOrig[plr] = store end
    if enabled then
        if store[attr] == nil then
            local cur = plr:GetAttribute(attr)
            store[attr] = (cur == nil) and "__nil" or cur
        end
        if plr:GetAttribute(attr) ~= value then plr:SetAttribute(attr, value) end
    elseif store[attr] ~= nil then
        local o = store[attr]
        plr:SetAttribute(attr, o ~= "__nil" and o or nil)
        store[attr] = nil
    end
end
