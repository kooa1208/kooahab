-- ===== Kill Effect (キルサウンドと同じタイミングで、倒した相手の位置にエフェクト) =====
do
    local TweenService = game:GetService("TweenService")
    local KE = { on = false, id = "121101509136996", style = "Electric + Asset", elec = Color3.fromRGB(150, 200, 255), size = 8, duration = 1.5, scale = 1, count = 30, color = Color3.new(1, 1, 1) }
    local Box = Tabs.Visual:AddRightGroupbox("Kill Effect")

    local function toTexture(id)
        id = tostring(id):gsub("%s", "")
        if id:match("^%d+$") then return "rbxassetid://" .. id end
        return id
    end

    -- アセットを実体として読み込む (モデル/パーティクル/Decal など。画像だけのIDだと失敗 → 画像として扱う)
    -- GetObjects がゲームによっては返ってこない(固まる)ことがあるので、別スレッドで読み込んで
    -- 最大 timeout 秒だけ待つ。間に合わなければ画像として表示する (読み込みはバックグラウンドで続く)
    local assetState = {}
    -- 失敗(nil / エラー)を永久キャッシュしない。起動直後やコンフィグ読込直後は GetObjects が
    -- 失敗/遅延しやすいので、成功するまでバックグラウンドで最大6回リトライする。
    local function startLoad(key)
        local st = assetState[key]
        if st and (st.loading or st.obj) then return st end
        if not st then st = { done = false, obj = nil, tries = 0 } assetState[key] = st end
        st.loading, st.done = true, false
        task.spawn(function()
            local n = 0
            while not st.obj and n < 6 and Match.alive do
                n += 1
                local finished = false
                task.spawn(function()
                    local ok, objs = pcall(function() return game:GetObjects(key) end)
                    if ok and type(objs) == "table" and objs[1] then st.obj = objs[1] end
                    finished = true
                end)
                local t0 = os.clock()
                while not finished and os.clock() - t0 < 8 do task.wait(0.1) end
                if not st.obj then task.wait(1.5) end
            end
            st.tries = st.tries + n
            st.loading, st.done = false, true
        end)
        return st
    end
    local function loadAsset(timeout)
        local key = toTexture(KE.id)
        local st = assetState[key] or startLoad(key) -- 失敗済みは再起動しない(画像IDで毎回待たされるのを防ぐ)
        local t0 = os.clock()
        while not st.done and not st.obj and os.clock() - t0 < (timeout or 2.5) do task.wait(0.05) end
        if st.obj then return st.obj, false end
        if not st.done then return nil, true end
        return nil, false
    end

    local function anchorAt(pos, life)
        local p = Instance.new("Part")
        p.Name = "KooaKillFx"; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
        p.Transparency = 1; p.Size = Vector3.one; p.CFrame = CFrame.new(pos); p.Parent = workspace
        task.delay(life, function() p:Destroy() end)
        return p
    end

    -- 画像がポンッと膨らんで消える
    local function imagePop(pos, tex)
        local a = anchorAt(pos, KE.duration + 0.3)
        local bb = Instance.new("BillboardGui")
        bb.Adornee = a; bb.AlwaysOnTop = true; bb.LightInfluence = 0
        bb.Size = UDim2.fromScale(KE.size * 0.3, KE.size * 0.3)
        local img = Instance.new("ImageLabel")
        img.BackgroundTransparency = 1; img.Size = UDim2.fromScale(1, 1)
        img.Image = tex; img.ImageColor3 = KE.color; img.ImageTransparency = 0
        img.Parent = bb; bb.Parent = a
        TweenService:Create(bb, TweenInfo.new(KE.duration * 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromScale(KE.size, KE.size) }):Play()
        task.delay(KE.duration * 0.5, function()
            TweenService:Create(img, TweenInfo.new(KE.duration * 0.5), { ImageTransparency = 1 }):Play()
        end)
    end

    -- 画像が四方に飛び散る
    local function particleBurst(pos, tex)
        local a = anchorAt(pos, KE.duration + 2)
        local pe = Instance.new("ParticleEmitter")
        pe.Texture = tex; pe.Rate = 0
        pe.Lifetime = NumberRange.new(KE.duration * 0.6, KE.duration)
        pe.Speed = NumberRange.new(8, 22)
        pe.SpreadAngle = Vector2.new(180, 180)
        pe.Drag = 3; pe.LightEmission = 0.5
        pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, KE.size * 0.25), NumberSequenceKeypoint.new(1, 0) })
        pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
        pe.Color = ColorSequence.new(KE.color)
        pe.Parent = a
        pe:Emit(KE.count)
    end

    -- 読み込んだモデル/パーティクルをその場に出す
    local function placeObject(obj, pos)
        local life = KE.duration + 1
        if obj:IsA("ParticleEmitter") then
            local a = anchorAt(pos, life)
            obj.Parent = a
            obj:Emit(math.max(1, math.floor(obj.Rate * 0.5)))
            return
        elseif obj:IsA("Attachment") then
            local a = anchorAt(pos, life)
            obj.Parent = a
            for _, d in ipairs(obj:GetDescendants()) do
                if d:IsA("ParticleEmitter") then d:Emit(math.max(1, math.floor(d.Rate * 0.5))) end
            end
            return
        elseif obj:IsA("BasePart") or obj:IsA("Model") then
            local list = { obj }
            for _, d in ipairs(obj:GetDescendants()) do list[#list + 1] = d end
            for _, d in ipairs(list) do
                if d:IsA("BasePart") then d.Anchored = true; d.CanCollide = false; d.CanQuery = false; d.CanTouch = false end
            end
            if obj:IsA("Model") then pcall(function() obj:ScaleTo(KE.scale) end) end
            obj:PivotTo(CFrame.new(pos))
            obj.Parent = workspace
            for _, d in ipairs(list) do
                if d:IsA("ParticleEmitter") then d:Emit(math.max(1, math.floor(d.Rate * 0.5))) end
            end
            task.delay(life, function() obj:Destroy() end)
            return
        end
        for _, child in ipairs(obj:GetChildren()) do placeObject(child:Clone(), pos) end
    end

    -- 青白い電撃の爆発 (動画のキルエフェクト風): 閃光 + 白い光球 + 火花 + 衝撃リング + 放射状アーク
    local function electricBurst(pos)
        local a = anchorAt(pos, 2)
        local col, white = KE.elec, Color3.new(1, 1, 1)
        local scale = KE.size / 8

        local light = Instance.new("PointLight")
        light.Color = col; light.Brightness = 12; light.Range = 28 * scale; light.Parent = a
        TweenService:Create(light, TweenInfo.new(0.45), { Brightness = 0 }):Play()

        local core = Instance.new("ParticleEmitter")
        core.Texture = "rbxasset://textures/particles/smoke_main.dds"; core.Rate = 0
        core.Lifetime = NumberRange.new(0.35, 0.5); core.Speed = NumberRange.new(0, 3)
        core.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, KE.size * 0.5), NumberSequenceKeypoint.new(0.4, KE.size * 1.3), NumberSequenceKeypoint.new(1, 0) })
        core.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
        core.Color = ColorSequence.new(white, col)
        core.LightEmission = 1; core.Parent = a
        core:Emit(5)

        local sp = Instance.new("ParticleEmitter")
        sp.Texture = "rbxasset://textures/particles/sparkles_main.dds"; sp.Rate = 0
        sp.Lifetime = NumberRange.new(0.4, 0.9); sp.Speed = NumberRange.new(25, 60)
        sp.SpreadAngle = Vector2.new(180, 180); sp.Drag = 4
        sp.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, KE.size * 0.12), NumberSequenceKeypoint.new(1, 0) })
        sp.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
        sp.Color = ColorSequence.new(col); sp.LightEmission = 1; sp.Parent = a
        sp:Emit(KE.count * 2)

        local ring = Instance.new("Part")
        ring.Shape = Enum.PartType.Ball; ring.Material = Enum.Material.Neon; ring.Color = col
        ring.Anchored = true; ring.CanCollide = false; ring.CanQuery = false; ring.CanTouch = false; ring.CastShadow = false
        ring.Transparency = 0.35; ring.Size = Vector3.one; ring.CFrame = CFrame.new(pos); ring.Parent = workspace
        TweenService:Create(ring, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * (KE.size * 2.2), Transparency = 1 }):Play()
        task.delay(0.5, function() ring:Destroy() end)

        local folder = Instance.new("Folder"); folder.Name = "KooaKillFx"; folder.Parent = workspace
        for _ = 1, 7 do
            local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8 - 0.2, math.random() - 0.5)
            if dir.Magnitude < 0.1 then dir = Vector3.new(0, 1, 0) end
            dir = dir.Unit
            local length = KE.size * (0.9 + math.random() * 0.8)
            local prev = pos
            for seg = 1, 4 do
                local jitter = Vector3.new(math.random(-10, 10), math.random(-10, 10), math.random(-10, 10)) * 0.04 * KE.size
                local nxt = pos + dir * (length * seg / 4) + jitter
                local d = (nxt - prev).Magnitude
                if d > 0.05 then
                    local p = Instance.new("Part")
                    p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false
                    p.Material = Enum.Material.Neon; p.Color = (seg % 2 == 0) and white or col
                    p.Size = Vector3.new(0.12, 0.12, d); p.CFrame = CFrame.lookAt((prev + nxt) / 2, nxt); p.Parent = folder
                    TweenService:Create(p, TweenInfo.new(0.25), { Transparency = 1 }):Play()
                end
                prev = nxt
            end
        end
        task.delay(0.4, function() folder:Destroy() end)
    end

    local function play(pos)
        local style = KE.style
        if style == "Electric Burst" then electricBurst(pos) return end
        if style == "Electric + Asset" then electricBurst(pos) style = "Auto" end
        local tex = toTexture(KE.id)
        local obj
        if style == "Auto" or style == "Asset (Model/Particle)" then
            local timedOut
            obj, timedOut = loadAsset(2.5)
            if timedOut then
                pcall(function() Library:Notify("Kill Effect: アセットの読み込みが遅いので画像として表示します", 4) end)
            end
        end
        if obj then
            if obj:IsA("Decal") or obj:IsA("Texture") then tex = obj.Texture; obj = nil
            elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then tex = obj.Image; obj = nil
            elseif obj:IsA("Sound") or obj:IsA("Animation") then obj = nil end
        end
        if style == "Asset (Model/Particle)" then
            if obj then placeObject(obj:Clone(), pos)
            else pcall(function() Library:Notify("Kill Effect: アセットを実体として読み込めませんでした (Styleを Image Pop / Particle Burst にしてください)", 5) end) end
        elseif obj then
            placeObject(obj:Clone(), pos)
        elseif style == "Particle Burst" then
            particleBurst(pos, tex)
        elseif style == "Image Pop" then
            imagePop(pos, tex)
        else
            imagePop(pos, tex); particleBurst(pos, tex)
        end
    end

    local lastAt = 0
    local function rootOf(ch)
        return ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart or ch:FindFirstChildWhichIsA("BasePart", true))
    end
    local function charPos(ch)
        local r = rootOf(ch)
        return r and (r.Position + Vector3.new(0, 1, 0)) or nil
    end
    local function kill(ch)
        if not KE.on then return end
        local pos = charPos(ch)
        if not pos then return end
        if os.clock() - lastAt < 0.4 then return end
        lastAt = os.clock()
        task.spawn(function()
            local ok, err = pcall(play, pos)
            if not ok then warn("[kooa] Kill Effect: " .. tostring(err)) end
        end)
    end
    Library.__kooaKillEffect = kill

    -- 初回キルでアセットの読み込みが間に合わず画像表示になる(Testを何回か押すと直る)問題の対策:
    -- 起動後・ONにした時・IDを変えた時に、先にバックグラウンドで読み込んでおく
    local function preloadAsset() pcall(function() startLoad(toTexture(KE.id)) end) end
    Library.__kooaKillEffectPreload = preloadAsset
    preloadAsset()
    task.delay(3, preloadAsset)

    -- Finisher は倒した相手が分からないので、Eliminationが来なければ視点に一番近い敵に出す
    Library.__kooaKillEffectFinisher = function()
        if not KE.on then return end
        task.delay(0.15, function()
            if os.clock() - lastAt < 0.6 then return end
            local cam = workspace.CurrentCamera
            if not cam then return end
            local best, bestAng
            local function consider(ch)
                if not ch or ch == LP.Character then return end
                local r = rootOf(ch)
                if not r then return end
                local d = r.Position - cam.CFrame.Position
                if d.Magnitude < 400 and d.Magnitude > 0.1 then
                    local ang = math.acos(math.clamp(cam.CFrame.LookVector:Dot(d.Unit), -1, 1))
                    if not bestAng or ang < bestAng then best, bestAng = ch, ang end
                end
            end
            for _, p in ipairs(Players:GetPlayers()) do consider(p.Character) end
            -- ダミー(トレーニング用など、Playerではないキャラ)も対象
            for _, h in ipairs(workspace:GetDescendants()) do
                if h:IsA("Humanoid") and h.Parent and h.Parent:IsA("Model") then consider(h.Parent) end
            end
            if best then kill(best) end
        end)
    end

    local t = Box:AddToggle("KillEffectToggle", { Text = "Enable Kill Effect", Default = false, Callback = function(v) KE.on = v if v then preloadAsset() end end })
    t:AddColorPicker("KillEffectColor", { Default = KE.color, Title = "Kill Effect Color", Callback = function(c) KE.color = c end })
    local elecLbl = Box:AddLabel("Electric Color")
    elecLbl:AddColorPicker("KillEffectElec", { Default = KE.elec, Title = "Electric Color", Callback = function(c) KE.elec = c end })
    Box:AddInput("KillEffectId", { Text = "Asset ID", Default = KE.id, Placeholder = "121101509136996", Finished = true, Callback = function(v)
        v = tostring(v or ""):gsub("%s", "")
        if v ~= "" then KE.id = v preloadAsset() end
    end })
    Box:AddDropdown("KillEffectStyle", { Text = "Style", Values = { "Electric + Asset", "Electric Burst", "Auto", "Image Pop", "Particle Burst", "Asset (Model/Particle)" }, Default = 1, Callback = function(v) KE.style = v end })
    Box:AddSlider("KillEffectSize", { Text = "Size", Min = 1, Max = 30, Default = KE.size, Rounding = 1, Callback = function(v) KE.size = v end })
    Box:AddSlider("KillEffectDuration", { Text = "Duration (sec)", Min = 0.3, Max = 5, Default = KE.duration, Rounding = 1, Callback = function(v) KE.duration = v end })
    Box:AddSlider("KillEffectCount", { Text = "Particle Count", Min = 5, Max = 100, Default = KE.count, Rounding = 0, Callback = function(v) KE.count = v end })
    Box:AddSlider("KillEffectScale", { Text = "Model Scale", Min = 0.1, Max = 10, Default = KE.scale, Rounding = 1, Callback = function(v) KE.scale = v end })
    Box:AddButton({ Text = "Test Kill Effect", Func = function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local pos = cam.CFrame.Position + cam.CFrame.LookVector * 14
        task.spawn(function()
            local ok, err = pcall(play, pos)
            if not ok then Library:Notify("Kill Effect エラー: " .. tostring(err), 6) end
        end)
    end })
end

-- ===== Notify Hit (当てたときに通知。{NAME} {DMG} {PART} {WEAPON} が使える) =====
do
    local NH = { on = false, dur = 3, picks = {}, last = 0 }
    local presets = { "{NAME}☆彡{DMG}", "{NAME} -{DMG}", "Hit {NAME} ({PART}) {DMG}", "{WEAPON} → {NAME} [{DMG}]", "{NAME} {DMG}dmg" }
    NH.picks[presets[1]] = true
    local Box = Tabs.Misc:AddRightGroupbox("Notify Hit")
    Box:AddToggle("NotifyHitOn", { Text = "enabled", Default = false, Callback = function(v) NH.on = v end })
    Box:AddSlider("NotifyHitDur", { Text = "notify duration", Min = 1, Max = 10, Default = 3, Rounding = 0, Suffix = "s", Callback = function(v) NH.dur = v end })
    local dd = Box:AddDropdown("NotifyHitText", { Text = "random notify text", Values = presets, Multi = true, Default = nil, AllowNull = true, Searchable = true, Callback = function(v)
        NH.picks = {}
        if type(v) == "table" then for k, on in pairs(v) do if on then NH.picks[k] = true end end end
    end })
    pcall(function() dd:SetValue({ [presets[1]] = true }) end)
    Box:AddInput("NotifyHitCustom", { Text = "add custom text", Default = "", Placeholder = "ex: {NAME}, {DMG}, {PART}", Finished = true, Callback = function(v)
        v = tostring(v or "")
        if v == "" or table.find(presets, v) then return end
        table.insert(presets, v)
        NH.picks[v] = true
        pcall(function() dd:SetValues(presets) dd:SetValue(NH.picks) end)
    end })
    Box:AddLabel("ALL FORMATTING:")
    Box:AddLabel("{NAME}, {DMG}, {PART}, {WEAPON}")

    Library.__kooaNotifyHit = function(part, args)
        if not NH.on then return end
        if os.clock() - NH.last < 0.05 then return end
        local list = {}
        for t in pairs(NH.picks) do list[#list + 1] = t end
        if #list == 0 then return end
        NH.last = os.clock()
        local ch = part:FindFirstAncestorOfClass("Model")
        local plr = ch and Players:GetPlayerFromCharacter(ch)
        local name = plr and plr.DisplayName or (ch and ch.Name) or "?"
        local dmg = "?"
        for i = 2, 4 do
            if type(args[i]) == "number" then dmg = tostring(math.floor(args[i] * 10 + 0.5) / 10) break end
        end
        local weapon = "?"
        pcall(function() local _, nm = Match.held(LP) if nm then weapon = tostring(nm) end end)
        local text = list[math.random(#list)]
        text = text:gsub("{NAME}", function() return name end):gsub("{DMG}", function() return dmg end)
                   :gsub("{PART}", function() return part.Name end):gsub("{WEAPON}", function() return weapon end)
        pcall(function() Library:Notify(text, NH.dur) end)
    end
end

-- ===== Rivals内部フック (Kiciaと同じ仕組み) =====
pcall(function() if getgenv().KooaSfxRestore then getgenv().KooaSfxRestore() end end)

local Hook = { rc = nil, origObjChanged = nil, vm = nil, origHitmarker = nil }

local function setField(t, k, v)
    pcall(function() if setreadonly then setreadonly(t, false) end end)
    pcall(function() if make_writeable then make_writeable(t) end end)
    rawset(t, k, v)
end

local function waitPath(root, names)
    local cur = root
    for _, n in ipairs(names) do
        if not cur then return nil end
        cur = cur:WaitForChild(n, 15)
    end
    return cur
end

local function applyMute()
    local vm = Hook.vm
    if not vm then return end
    if HS.mute then
        if not Hook.origHitmarker then
            local m = rawget(vm, "PlayHitmarkerSound")
            if m then
                Hook.origHitmarker = m
                setField(vm, "PlayHitmarkerSound", function() end)
            end
        end
    elseif Hook.origHitmarker then
        setField(vm, "PlayHitmarkerSound", Hook.origHitmarker)
        Hook.origHitmarker = nil
    end
end

local function restoreHooks()
    pcall(function()
        if Hook.rc and Hook.origObjChanged then setField(Hook.rc, "_ObjectChanged", Hook.origObjChanged) end
        Hook.origObjChanged = nil
        if Hook.vm and Hook.origHitmarker then setField(Hook.vm, "PlayHitmarkerSound", Hook.origHitmarker) end
        Hook.origHitmarker = nil
    end)
end
getgenv().KooaSfxRestore = restoreHooks
pcall(function() Library:OnUnload(restoreHooks) end)
pcall(function() Library:OnUnload(function() getgenv().KooaLoaded = nil end) end)

task.spawn(function()
    local ok, err = pcall(function()
        local ps = LP:WaitForChild("PlayerScripts", 15)
        local RS = game:GetService("ReplicatedStorage")
        local rcInst = waitPath(ps, { "Modules", "ReplicatedController" })
        local fcInst = waitPath(ps, { "Controllers", "FighterController" })
        local enumInst = waitPath(RS, { "Modules", "EnumLibrary" })
        local vmInst = waitPath(ps, { "Modules", "ClientReplicatedClasses", "ClientFighter", "ClientItem", "ClientViewModel" })
        assert(rcInst and fcInst and enumInst, "Rivals module not found")

        local rc, fc, enumLib = require(rcInst), require(fcInst), require(enumInst)
        local fromEnum = rawget(enumLib, "_from_enum")
        local orig = rawget(rc, "_ObjectChanged")
        assert(fromEnum and orig, "_ObjectChanged / EnumLibrary not found")

        if vmInst then Hook.vm = require(vmInst) end

        local function localObjectId()
            local map = rawget(fc, "_player_to_fighter")
            local f = map and (rawget(map, LP) or map[LP])
            local data = f and rawget(f, "Data")
            return data and rawget(data, "ObjectID")
        end

        local function onEffect(name, objectId, args)
            if name == "DamageNumberEffect" then
                if objectId ~= localObjectId() then return end      -- 自分が与えたダメージだけ
                local part = args[1]
                if typeof(part) ~= "Instance" or part.Parent == nil then return end
                local nh = Library.__kooaNotifyHit
                if nh then pcall(nh, part, args) end
                if not HS.on then return end
                hitSound(args[3] == true)                             -- args[3] = ヘッドショット
            elseif name == "FinisherEffect" then
                if args[3] ~= LP then return end                      -- 自分のフィニッシャーのみ
                if KS.on then killSound() end
                local fx = Library.__kooaKillEffectFinisher
                if fx then fx() end
            elseif name == "EliminationEffect" then
                if objectId ~= localObjectId() then return end
                local victim = args[1]
                if typeof(victim) ~= "Instance" or victim == LP then return end
                local vch = victim:IsA("Player") and victim.Character or (victim:IsA("Model") and victim) or nil
                if not vch then return end
                if KS.on then killSound() end
                local fx = Library.__kooaKillEffect
                if fx then fx(vch) end
            end
        end

        Hook.rc = rc
        Hook.origObjChanged = orig
