        VisualLeft3:AddSlider("SkyMoonSize", { Text = "Moon Size (deg)", Min = 1, Max = 40, Default = 9, Rounding = 1, Callback = function(v) M.size = v end })
        VisualLeft3:AddSlider("SkyMoonDir", { Text = "Moon Direction (deg)", Min = 0, Max = 360, Default = 0, Rounding = 0, Callback = function(v) M.dir = v end })
        VisualLeft3:AddSlider("SkyMoonHeight", { Text = "Moon Height (deg)", Min = 0, Max = 85, Default = 25, Rounding = 0, Callback = function(v) M.elev = v end })
        VisualLeft3:AddSlider("SkyMoonOpacity", { Text = "Moon Opacity (%)", Min = 20, Max = 100, Default = 88, Rounding = 0, Callback = function(v) img.ImageTransparency = 1 - v / 100 end })
        VisualLeft3:AddSlider("SkyMoonGlow", { Text = "Moon Glow (%)", Min = 0, Max = 100, Default = 50, Rounding = 0, Callback = function(v) M.glow = v / 100 applyGlow() end })
        VisualLeft3:AddButton({ Text = "Put moon in front of me", Func = function() placeHere() end })
        -- ===== 本物の空の月 (Roblox標準の月。時間を夜にして、暗くなった分を補正) =====
        local function rmT(id, v) local t = Library.Toggles[id] if t then pcall(function() t:SetValue(v) end) end end
        local function rmO(id, v) local o = Library.Options[id] if o then pcall(function() o:SetValue(v) end) end end
        local function rmC(id, c)
            local o = Library.Options[id]
            if o then pcall(function() if o.SetValueRGB then o:SetValueRGB(c) else o:SetValue(c) end end) end
        end
        local function rmGet(id) local t = Library.Toggles[id] return t and t.Value end
        local function realMoonLight()
            if realMoon.gray > 0 then
                local c = Color3.fromRGB(realMoon.gray, realMoon.gray, math.min(255, realMoon.gray + 15))
                rmC("LAmbientC1", c); rmC("LAmbientC2", c); rmT("LAmbientOn", true)
            elseif not realMoon.ambWas then
                rmT("LAmbientOn", false)
            end
        end
        local function realMoonApply(on)
            if on then
                realMoon.clockWas = rmGet("LClockOn")
                realMoon.ambWas = rmGet("LAmbientOn")
                realMoon.latWas = rmGet("LLatitudeOn")
                realMoon.expWas = rmGet("LExposureOn")
            end
            realMoon.on = on
            applySky()
            if on then
                rmO("LClockVal", realMoon.time); rmT("LClockOn", true)
                realMoonLight()
                rmO("LExposureVal", realMoon.exp); rmT("LExposureOn", true)
            else
                if not realMoon.expWas then rmT("LExposureOn", false) end
                if not realMoon.clockWas then rmT("LClockOn", false) end
                if not realMoon.ambWas then rmT("LAmbientOn", false) end
                if not realMoon.latWas then rmT("LLatitudeOn", false) end
            end
        end

        -- 今向いている方向に月が来る「時刻 + 緯度」を探す (月の通り道は東西を結ぶ線上なので、時刻だけでは視界に入らないことがある)
        local function findMoon()
            local cam = workspace.CurrentCamera
            if not cam then return nil, "no-camera" end
            local look = cam.CFrame.LookVector
            local lh = Vector3.new(look.X, 0, look.Z)
            if lh.Magnitude < 1e-3 then return nil, "no-look" end
            lh = lh.Unit
            local el = math.rad(realMoon.elev)
            local target = lh * math.cos(el) + Vector3.new(0, math.sin(el), 0)
            local t0, l0 = Lighting.ClockTime, Lighting.GeographicLatitude
            local best, bt, bl = -2, t0, l0
            local first, varied = nil, false
            local function try(t, lat)
                local ok = pcall(function()
                    Lighting.ClockTime = t
                    Lighting.GeographicLatitude = lat
                end)
                if not ok then return end
                local ok2, d = pcall(function() return Lighting:GetMoonDirection() end)
                if not ok2 or typeof(d) ~= "Vector3" then return end
                if first == nil then first = d elseif (d - first).Magnitude > 1e-3 then varied = true end
                local sc = d:Dot(target)
                if sc > best then best, bt, bl = sc, t, lat end
            end
            for lat = 0, 345, 15 do
                for i = 0, 47 do try(i * 0.5, lat) end
            end
            local t1, l1 = bt, bl
            for dt = -0.5, 0.5, 0.02 do try((t1 + dt) % 24, l1) end
            pcall(function() Lighting.ClockTime = t0; Lighting.GeographicLatitude = l0 end)
            if not varied then return nil, "no-api" end
            return bt, bl, math.deg(math.acos(math.clamp(best, -1, 1)))
        end
        local rmAcc = 0
        RunService.Heartbeat:Connect(function(dt)
            if not realMoon.on then return end
            rmAcc = rmAcc + dt
            if rmAcc < 0.5 then return end
            rmAcc = 0
            for _, o in ipairs(Lighting:GetChildren()) do
                if o:IsA("Sky") then
                    pcall(function()
                        if not o.CelestialBodiesShown then o.CelestialBodiesShown = true end
                        if o.MoonAngularSize ~= realMoon.size then o.MoonAngularSize = realMoon.size end
                        if o.MoonTextureId ~= "rbxasset://sky/moon.jpg" then o.MoonTextureId = "rbxasset://sky/moon.jpg" end
                    end)
                end
            end
        end)
        VisualLeft3:AddToggle("RealMoon", { Text = "Real Sky Moon (本物の空の月)", Default = false, Callback = function(v)
            if v then rmT("SkyMoonForce", false) end
            realMoonApply(v)
        end })
        VisualLeft3:AddSlider("RealMoonTime", { Text = "Real Moon 時刻 (月の位置)", Min = 0, Max = 24, Default = 21, Rounding = 1, Callback = function(v)
            realMoon.time = v
            if realMoon.on then rmO("LClockVal", v) end
        end })
        VisualLeft3:AddSlider("RealMoonSize", { Text = "Real Moon Size", Min = 1, Max = 60, Default = 18, Rounding = 0, Callback = function(v)
            realMoon.size = v
            if realMoon.on then applySky() end
        end })
        VisualLeft3:AddSlider("RealMoonBright", { Text = "Real Moon 暗さ補正 (0=なし)", Min = 0, Max = 255, Default = 150, Rounding = 0, Callback = function(v)
            realMoon.gray = v
            if realMoon.on then realMoonLight() end
        end })
        VisualLeft3:AddSlider("RealMoonExposure", { Text = "Real Moon 露出 (明るさ)", Min = -1, Max = 3, Default = 0.5, Rounding = 1, Callback = function(v)
            realMoon.exp = v
            if realMoon.on then rmO("LExposureVal", v) end
        end })
        VisualLeft3:AddSlider("RealMoonElev", { Text = "Real Moon 高さ (deg)", Min = 0, Max = 80, Default = 25, Rounding = 0, Callback = function(v) realMoon.elev = v end })
        VisualLeft3:AddButton({ Text = "Real Moon: 今向いてる方向に出す", Func = function()
            if not realMoon.on then pcall(function() Library.Toggles.RealMoon:SetValue(true) end) end
            local t, l, err = findMoon()
            if not t then
                Library:Notify("Real Moon: 計算できませんでした (" .. tostring(l) .. ")", 6)
                return
            end
            realMoon.time = math.floor(t * 100 + 0.5) / 100
            rmO("LClockVal", realMoon.time); rmT("LClockOn", true)
            rmO("LLatitudeVal", l); rmT("LLatitudeOn", true)
            pcall(function() Library.Options.RealMoonTime:SetValue(math.floor(t * 10 + 0.5) / 10) end)
            if err > 20 then
                Library:Notify(string.format("Real Moon: 時刻%.1f 緯度%.1f に設定。ただしこの向きだと %.0f° ずれます。南北どちらかを向いて、もう一度押してください", t, l, err), 9)
            else
                Library:Notify(string.format("Real Moon: 時刻%.1f 緯度%.1f に設定 (ずれ %.0f°)", t, l, err), 6)
            end
        end })
        VisualLeft3:AddButton({ Text = "Real Moon Debug", Func = function()
            local parts = {}
            pcall(function()
                local d = Lighting:GetMoonDirection()
                local cam = workspace.CurrentCamera
                local ang = cam and math.deg(math.acos(math.clamp(cam.CFrame.LookVector:Dot(d), -1, 1))) or -1
                local sky = Lighting:FindFirstChildOfClass("Sky")
                local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
                parts[#parts + 1] = string.format("on=%s time=%.2f lat=%.1f 月の高さ=%.0f° カメラとの角度=%.0f°", tostring(realMoon.on), Lighting.ClockTime, Lighting.GeographicLatitude, math.deg(math.asin(d.Y)), ang)
                parts[#parts + 1] = sky and string.format("sky: bodies=%s moonSize=%s tex=%s", tostring(sky.CelestialBodiesShown), tostring(sky.MoonAngularSize), tostring(sky.MoonTextureId)) or "sky: なし"
                local nSky, where = 0, {}
                for _, o in ipairs(game:GetDescendants()) do
                    if o:IsA("Sky") then nSky = nSky + 1; where[#where + 1] = o.Parent and o.Parent.Name or "?" end
                end
                parts[#parts + 1] = "Skyの数=" .. nSky .. " (" .. table.concat(where, ",") .. ")"
                parts[#parts + 1] = atmo and string.format("atmo: density=%.2f haze=%.2f", atmo.Density, atmo.Haze) or "atmo: なし"
            end)
            Library:Notify("Real Moon: " .. table.concat(parts, " | "), 14)
        end })
        VisualLeft3:AddButton({ Text = "Moon Debug", Func = function()
            Library:Notify(string.format("Moon: on=%s loaded=%s visible=%s dir=%d elev=%d size=%.1f image=%s",
                tostring(moonOn), tostring(img.IsLoaded), tostring(img.Visible), M.dir, M.elev, M.size, tostring(img.Image)), 10)
        end })
    end
end
