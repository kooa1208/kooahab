local playerEntries = {}
local function createPlayerEntry(player, yPos)
    local entryFrame = Instance.new("Frame")
    entryFrame.Size = UDim2.new(1,0,0,50)
    entryFrame.Position = UDim2.new(0,0,0,yPos)
    entryFrame.BackgroundColor3 = Color3.fromRGB(35,35,40)
    entryFrame.Parent = playerListContainer
    
    local iconImage = Instance.new("ImageLabel")
    iconImage.Size = UDim2.new(0,40,0,40)
    iconImage.Position = UDim2.new(0,5,0,5)
    iconImage.BackgroundColor3 = Color3.fromRGB(50,50,55)
    iconImage.Parent = entryFrame
    spawn(function() pcall(function() iconImage.Image = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420) end) end)
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(0.5,0,0,25)
    nameLabel.Position = UDim2.new(0,50,0,0)
    nameLabel.Text = player.Name
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 11
    nameLabel.TextColor3 = Color3.fromRGB(200,200,220)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = entryFrame
    
    local idLabel = Instance.new("TextLabel")
    idLabel.Size = UDim2.new(0.5,0,0,20)
    idLabel.Position = UDim2.new(0,50,0,25)
    idLabel.Text = "ID: " .. player.UserId
    idLabel.Font = Enum.Font.Gotham
    idLabel.TextSize = 9
    idLabel.TextColor3 = Color3.fromRGB(150,150,170)
    idLabel.BackgroundTransparency = 1
    idLabel.TextXAlignment = Enum.TextXAlignment.Left
    idLabel.Parent = entryFrame
    
    local safeButton = createButton("SAFE", 1,-130,60, entryFrame) safeButton.Position = UDim2.new(1,-130,0,12) safeButton.Size = UDim2.new(0,60,0,25)
    local outButton = createButton("OUT", 1,-65,60, entryFrame) outButton.Position = UDim2.new(1,-65,0,12) outButton.Size = UDim2.new(0,60,0,25)
    
    local savedStatus = blacklist[tostring(player.UserId)]
    if savedStatus == "safe" then nameLabel.TextColor3 = Color3.fromRGB(100,255,100) safeButton.BackgroundColor3 = Color3.fromRGB(40,80,40)
    elseif savedStatus == "out" then nameLabel.TextColor3 = Color3.fromRGB(255,100,100) outButton.BackgroundColor3 = Color3.fromRGB(80,40,40) end

    safeButton.MouseButton1Click:Connect(function()
        notify("SAFE 設定"); blacklist[tostring(player.UserId)] = "safe" saveBlacklist()
        nameLabel.TextColor3 = Color3.fromRGB(100,255,100); safeButton.BackgroundColor3 = Color3.fromRGB(40,80,40); outButton.BackgroundColor3 = Color3.fromRGB(35,35,40)
    end)
    outButton.MouseButton1Click:Connect(function()
        notify("OUT 設定"); blacklist[tostring(player.UserId)] = "out" saveBlacklist()
        nameLabel.TextColor3 = Color3.fromRGB(255,100,100); outButton.BackgroundColor3 = Color3.fromRGB(80,40,40); safeButton.BackgroundColor3 = Color3.fromRGB(35,35,40)
    end)
end

local function updatePlayerList()
    for _, entry in pairs(playerEntries) do if entry and entry.Parent then entry:Destroy() end end
    playerEntries = {}
    local yPos = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local entry = createPlayerEntry(player, yPos)
            table.insert(playerEntries, entry)
            yPos += 55
        end
    end
    blacklistScrollFrame.CanvasSize = UDim2.new(0,0,0, math.max(400, yPos+10))
end

Players.PlayerAdded:Connect(function() wait(0.5) updatePlayerList() end)
Players.PlayerRemoving:Connect(function() wait(0.5) updatePlayerList() end)

