-- ViewModel Highlight / Chams (Kiciaの Arms / Item 設定を移植)
-- ------------------------------------------------
do
    local HLBox = Tabs.Visual:AddLeftGroupbox("ViewModel Highlight")
    local CHBox = Tabs.Visual:AddRightGroupbox("ViewModel Chams")

    local function fpRoot()
        local vm = workspace:FindFirstChild("ViewModels")
        return vm and vm:FindFirstChild("FirstPerson")
    end
    local function armModels()
        local out, fp = {}, fpRoot()
        if not fp then return out end
        for _, m in ipairs(fp:GetChildren()) do
            local n = m.Name:lower()
            if n:find("arm") or n:find("glove") then table.insert(out, m) end
        end
        return out
    end
    local function itemModels()
        local out, fp = {}, fpRoot()
        if not fp then return out end
        for _, d in ipairs(fp:GetDescendants()) do
            local n = d.Name:lower()
            if n == "itemvisual" or n == "itemmodel" then table.insert(out, d) end
        end
        return out
    end

    local needClean = false
    local hlCfg = {
        arms = { on = false, fill = Color3.new(1, 1, 1), fillT = 0.5, out = Color3.new(1, 1, 1), outT = 0, top = false },
        item = { on = false, fill = Color3.new(1, 1, 1), fillT = 0.5, out = Color3.new(1, 1, 1), outT = 0, top = false },
    }
    local chCfg = {
        arms = { on = false, mat = "ForceField", color = Color3.fromRGB(255, 0, 255), trans = 0 },
        item = { on = false, mat = "ForceField", color = Color3.new(1, 1, 1), trans = 0 },
    }
    local mats = {
        ForceField = Enum.Material.ForceField, Neon = Enum.Material.Neon, Glass = Enum.Material.Glass,
        SmoothPlastic = Enum.Material.SmoothPlastic, Plastic = Enum.Material.Plastic, Metal = Enum.Material.Metal,
    }
    local matNames = { "ForceField", "Neon", "Glass", "SmoothPlastic", "Plastic", "Metal" }

    local hls = { arms = {}, item = {} }
    local function syncHL(kind, targets)
        local c, map, seen = hlCfg[kind], hls[kind], {}
        if c.on then
            for _, t in ipairs(targets) do
                seen[t] = true
                local h = map[t]
                if not h or not h.Parent then
                    h = Instance.new("Highlight"); h.Name = "KooaVMHighlight"; h.Adornee = t; h.Parent = t
                    map[t] = h
                end
                h.FillColor = c.fill; h.FillTransparency = c.fillT
                h.OutlineColor = c.out; h.OutlineTransparency = c.outT
                h.DepthMode = c.top and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
            end
        end
        for t, h in pairs(map) do
            if not seen[t] then pcall(function() h:Destroy() end) map[t] = nil end
        end
    end

    local orig = setmetatable({}, { __mode = "k" })
    local touched = { arms = {}, item = {} }
    local function restore(p)
        local o = orig[p]
        if o and p.Parent then
            p.Material, p.Color, p.Transparency = o[1], o[2], o[3]
        end
        orig[p] = nil
    end
    local function syncCh(kind, targets)
        local c, seen = chCfg[kind], {}
        if c.on then
            for _, t in ipairs(targets) do
                local list = { t }
                for _, d in ipairs(t:GetDescendants()) do list[#list + 1] = d end
                for _, p in ipairs(list) do
                    if p:IsA("BasePart") then
                        if not orig[p] then orig[p] = { p.Material, p.Color, p.Transparency } end
                        if orig[p][3] < 1 then
                            seen[p] = true
                            p.Material = mats[c.mat] or Enum.Material.ForceField
                            p.Color = c.color
                            p.Transparency = c.trans
                        end
                    end
                end
            end
        end
        for p in pairs(touched[kind]) do
            if not seen[p] then restore(p) end
        end
        touched[kind] = seen
    end

    task.spawn(function()
        while true do
            task.wait(0.25)
            local any = hlCfg.arms.on or hlCfg.item.on or chCfg.arms.on or chCfg.item.on
            if any or needClean then
                needClean = false
                pcall(function()
                    local arms, items = armModels(), itemModels()
                    syncHL("arms", arms); syncHL("item", items)
                    syncCh("arms", arms); syncCh("item", items)
                end)
            end
        end
    end)

    local function hlUI(kind, title)
        local c = hlCfg[kind]
        local t = HLBox:AddToggle("VMHL_" .. kind, { Text = title .. " Highlight", Default = false, Callback = function(v) c.on = v needClean = true end })
        t:AddColorPicker("VMHL_" .. kind .. "_Fill", { Default = c.fill, Title = title .. " Fill", Callback = function(col) c.fill = col end })
        t:AddColorPicker("VMHL_" .. kind .. "_Out", { Default = c.out, Title = title .. " Outline", Callback = function(col) c.out = col end })
        HLBox:AddSlider("VMHL_" .. kind .. "_FillT", { Text = title .. " Fill Transparency", Min = 0, Max = 1, Default = 0.5, Rounding = 2, Callback = function(v) c.fillT = v end })
        HLBox:AddSlider("VMHL_" .. kind .. "_OutT", { Text = title .. " Outline Transparency", Min = 0, Max = 1, Default = 0, Rounding = 2, Callback = function(v) c.outT = v end })
        HLBox:AddToggle("VMHL_" .. kind .. "_Top", { Text = title .. " Always On Top", Default = false, Callback = function(v) c.top = v end })
    end
    hlUI("arms", "Arms")
    hlUI("item", "Item")

    local function chUI(kind, title)
        local c = chCfg[kind]
        local t = CHBox:AddToggle("VMCH_" .. kind, { Text = title .. " Chams", Default = false, Callback = function(v) c.on = v needClean = true end })
        t:AddColorPicker("VMCH_" .. kind .. "_Color", { Default = c.color, Title = title .. " Chams Color", Callback = function(col) c.color = col end })
        CHBox:AddDropdown("VMCH_" .. kind .. "_Mat", { Text = title .. " Material", Values = matNames, Default = 1, Callback = function(v) c.mat = v end })
        CHBox:AddSlider("VMCH_" .. kind .. "_Trans", { Text = title .. " Transparency", Min = 0, Max = 1, Default = 0, Rounding = 2, Callback = function(v) c.trans = v end })
    end
    chUI("arms", "Arms")
    chUI("item", "Item")
end


