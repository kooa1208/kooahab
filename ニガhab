-- FPS Boost (元の値を保存して、OFFで戻す)
local boostOn, boostSaved, boostConn = false, {}, nil
local savedQuality, savedShadows
local function boostInstance(o)
    if o:IsA("BasePart") then
        if boostSaved[o] == nil then boostSaved[o] = { o.Material, o.Reflectance, o.CastShadow } end
        o.Material = Enum.Material.SmoothPlastic; o.Reflectance = 0; o.CastShadow = false
    elseif o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Smoke") or o:IsA("Fire") or o:IsA("Sparkles") then
        if boostSaved[o] == nil then boostSaved[o] = { o.Enabled } end
        o.Enabled = false
    end
end
local function setBoost(v)
    boostOn = v
    if v then
        pcall(function() savedQuality = settings().Rendering.QualityLevel; settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        savedShadows = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
        task.spawn(function()
            local n = 0
            for _, o in ipairs(workspace:GetDescendants()) do
                if not boostOn then return end
                local ch = LP.Character
                if not (ch and o:IsDescendantOf(ch)) then boostInstance(o) end
                n += 1
                if n % 400 == 0 then task.wait() end
            end
        end)
        boostConn = workspace.DescendantAdded:Connect(function(o) if boostOn then boostInstance(o) end end)
    else
        if boostConn then boostConn:Disconnect() boostConn = nil end
        pcall(function() if savedQuality then settings().Rendering.QualityLevel = savedQuality end end)
        if savedShadows ~= nil then Lighting.GlobalShadows = savedShadows end
        task.spawn(function()
            local n = 0
            for o, vals in pairs(boostSaved) do
                if o and o.Parent then
                    pcall(function()
                        if o:IsA("BasePart") then o.Material, o.Reflectance, o.CastShadow = vals[1], vals[2], vals[3]
                        else o.Enabled = vals[1] end
                    end)
                end
                n += 1
                if n % 400 == 0 then task.wait() end
            end
            table.clear(boostSaved)
        end)
    end
end
VisualMisc:AddToggle("FpsBoostToggle", { Text = "FPS Boost", Default = false, Callback = setBoost })
